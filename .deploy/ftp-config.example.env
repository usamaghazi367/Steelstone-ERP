# Copy to ftp-config.env and fill once (never commit ftp-config.env).
# SmarterASP: Control Panel -> Websites -> your site -> Manage -> FTP Access
SMARTERASP_FTP_SERVER=ftp.smarterasp.net
SMARTERASP_FTP_USERNAME=your-ftp-username-here
SMARTERASP_FTP_PASSWORD=your-ftp-password-here
SMARTERASP_FTP_REMOTE_DIR=/
