{
  "code": "01",
  "name": "ENTERPRISE REGISTRATION",
  "category": "ERP Module",
  "recordCodePrefix": "ENT",
  "listColumns": [
    "_recordCode",
    "1.1",
    "1.2",
    "1.3"
  ],
  "sections": [
    {
      "num": 1,
      "title": "BUSINESS REGISTRATION",
      "repeating": false
    },
    {
      "num": 2,
      "title": "REGISTERED OFFICE & OTHER ADDRESSES",
      "repeating": false
    },
    {
      "num": 3,
      "title": "POINTS OF CONTACT (POC)",
      "repeating": false
    },
    {
      "num": 4,
      "title": "BANKING DETAILS - multiple options",
      "repeating": false
    }
  ],
  "fields": [
    {
      "ref": "1.1",
      "field": "Business name (Title)",
      "dataType": "Text (150)",
      "mandatory": "Yes",
      "validation": "Registered name as per SECP / Registrar of Firms / FBR NTN record; for a sole proprietor or individual, the name as per CNIC.",
      "sampleEntry": "Steelstone IT (Private) Limited",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Legal status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Company / AOP / Sole Proprietor / Individual. Determines whether NTN or CNIC is required in field 1.3.",
      "sampleEntry": "Company",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "NTN / CNIC number",
      "dataType": "Text (15)",
      "mandatory": "Yes",
      "validation": "Company and AOP: NTN - 7 digits + '-' + check digit. Sole Proprietor and Individual: 13-digit CNIC (XXXXX-XXXXXXX-X) in lieu of NTN. Unique per record.",
      "sampleEntry": "1234567-8",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Filer status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Filer / Non-filer as per the FBR Active Taxpayer List - drives the withholding tax rates applied in the ERP.",
      "sampleEntry": "Filer",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Registered office - address line 1",
      "dataType": "Text (150)",
      "mandatory": "Yes",
      "validation": "Company: as per SECP Form A / Form 29. AOP: as per Form II / deed.",
      "sampleEntry": "Office 402, 4th Floor, Arfa Software Technology Park",
      "section": 2
    },
    {
      "ref": "2.2",
      "field": "Registered office - address line 2",
      "dataType": "Text (150)",
      "mandatory": "No",
      "validation": "Street / sector / landmark.",
      "sampleEntry": "346-B, Ferozepur Road",
      "section": 2
    },
    {
      "ref": "2.3",
      "field": "City",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Master list of Pakistani cities.",
      "sampleEntry": "Lahore",
      "section": 2
    },
    {
      "ref": "2.4",
      "field": "District / Tehsil",
      "dataType": "Text (50)",
      "mandatory": "No",
      "validation": "Auto-filled from city where available.",
      "sampleEntry": "Lahore",
      "section": 2
    },
    {
      "ref": "2.5",
      "field": "Province / Territory",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Punjab / Sindh / KPK / Balochistan / Gilgit-Baltistan / AJK / Islamabad ICT",
      "sampleEntry": "Punjab",
      "section": 2
    },
    {
      "ref": "2.6",
      "field": "Country",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Default: Pakistan",
      "sampleEntry": "Pakistan",
      "section": 2
    },
    {
      "ref": "2.7",
      "field": "Is the registered office the same as the main business address?",
      "dataType": "Yes / No",
      "mandatory": "Yes",
      "validation": "If No, both addresses are stored separately against the tenant.",
      "sampleEntry": "Yes",
      "section": 2
    },
    {
      "ref": "2.8",
      "field": "Correspondence / mailing address (if different)",
      "dataType": "Text (300)",
      "mandatory": "Conditional",
      "validation": "Include city, province and postal code.",
      "sampleEntry": "12-C, Gulberg III, Lahore, Punjab 54660",
      "section": 2
    },
    {
      "ref": "2.9",
      "field": "Branch / factory / warehouse address(es)",
      "dataType": "Repeating table",
      "mandatory": "Conditional",
      "validation": "One row per site: site type, address, city, province, provincial tax jurisdiction. Required if multi-branch is enabled.",
      "sampleEntry": "Warehouse - Plot 45, Sundar Industrial Estate, Lahore",
      "section": 2
    },
    {
      "ref": "2.10",
      "field": "Landline number",
      "dataType": "Phone",
      "mandatory": "No",
      "validation": "Format +92-XX-XXXXXXXX",
      "sampleEntry": "+92-42-35880011",
      "section": 2
    },
    {
      "ref": "2.11",
      "field": "Geo-coordinates of main business address (lat, long)",
      "dataType": "Text (30)",
      "mandatory": "No",
      "validation": "Decimal degrees; used by the logistics / delivery module.",
      "sampleEntry": "31.4697, 74.2728",
      "section": 2
    },
    {
      "ref": "3.1",
      "field": "Primary POC - full name",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "As per CNIC.",
      "sampleEntry": "Ahmed Raza Khan",
      "section": 3
    },
    {
      "ref": "3.2",
      "field": "Primary POC - designation",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Free text.",
      "sampleEntry": "Chief Executive Officer",
      "section": 3
    },
    {
      "ref": "3.3",
      "field": "Primary POC - mobile",
      "dataType": "Phone",
      "mandatory": "Yes",
      "validation": "+92-3XX-XXXXXXX",
      "sampleEntry": "+92-321-4567890",
      "section": 3
    },
    {
      "ref": "4.1",
      "field": "Bank name",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "SBP-licensed scheduled bank.",
      "sampleEntry": "Meezan Bank Limited",
      "section": 4
    },
    {
      "ref": "4.2",
      "field": "Title of account",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "Must match the registered legal name in field 1.1.",
      "sampleEntry": "Steelstone IT (Private) Limited",
      "section": 4
    },
    {
      "ref": "4.3",
      "field": "Account number",
      "dataType": "Text (20)",
      "mandatory": "Yes",
      "validation": "Numeric, as issued by the bank.",
      "sampleEntry": "1230010012345",
      "section": 4
    }
  ]
}