      "mandatory": "Yes",
      "validation": "Cement is excisable under the Federal Excise Act 2005 - required for correct invoice tax lines.",
      "sampleEntry": "FED-0098765-4",
      "section": 2
    },
    {
      "ref": "2.10",
      "field": "Sales tax withholding regime applicable",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Withheld at source / Exempt from withholding / Not applicable.",
      "sampleEntry": "Withheld at source",
      "section": 2
    },
    {
      "ref": "2.11",
      "field": "Tax exemption / reduced-rate certificate no. & issuing authority",
