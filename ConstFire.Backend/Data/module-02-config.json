{
  "code": "02",
  "name": "MANUFACTURER (SUPPLIER) REGISTRATION",
  "category": "ERP Module",
  "recordCodePrefix": "MFR",
  "listColumns": [
    "_recordCode",
    "1.1",
    "1.2",
    "1.3"
  ],
  "sections": [
    {
      "num": 1,
      "title": "BUSINESS REGISTRATION",
      "repeating": false
    },
    {
      "num": 2,
      "title": "PLANTS / PRODUCTION FACILITIES  (repeating block - multiple plants supported)",
      "repeating": true
    },
    {
      "num": 3,
      "title": "POINTS OF CONTACT  (repeating block - minimum 2, unlimited additional contacts)",
      "repeating": true
    },
    {
      "num": 4,
      "title": "BANK ACCOUNT DETAILS  (repeating block - multiple accounts supported)",
      "repeating": true
    },
    {
      "num": 5,
      "title": "WORKING CALENDAR, SHIFTS & DISPATCH WINDOWS",
      "repeating": false
    },
    {
      "num": 6,
      "title": "PRODUCT PRICING  (repeating block - one line per product)",
      "repeating": true
    },
    {
      "num": 7,
      "title": "WITHHOLDING TAX EXEMPTION",
      "repeating": false
    }
  ],
  "fields": [
    {
      "ref": "1.1",
      "field": "Business name (Title)",
      "dataType": "Text (150)",
      "mandatory": "Yes",
      "validation": "Registered name as per SECP / Registrar of Firms / FBR NTN record; for a sole proprietor or individual, the name as per CNIC.",
      "sampleEntry": "Pak Cement Industries Limited",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Legal status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Company / AOP / Sole Proprietor / Individual. Determines whether NTN or CNIC is required in field 1.3.",
      "sampleEntry": "Company",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "NTN / CNIC number",
      "dataType": "Text (15)",
      "mandatory": "Yes",
      "validation": "Company and AOP: NTN - 7 digits + '-' + check digit. Sole Proprietor and Individual: 13-digit CNIC (XXXXX-XXXXXXX-X) in lieu of NTN. Unique per record.",
      "sampleEntry": "0098765-4",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Filer status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Filer / Non-filer as per the FBR Active Taxpayer List - drives the withholding tax rates applied in the ERP.",
      "sampleEntry": "Filer",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Plant serial no.",
      "dataType": "Integer",
      "mandatory": "Yes",
      "validation": "REPEATING BLOCK - unlimited plants supported. Add one row set per production facility.",
      "sampleEntry": "1",
      "section": 2
    },
    {
      "ref": "2.2",
      "field": "Plant name",
      "dataType": "Text (80)",
      "mandatory": "Yes",
      "validation": "Common name by which the facility is known.",
      "sampleEntry": "Nooriabad Cement Plant",
      "section": 2
    },
    {
      "ref": "2.3",
      "field": "Plant code",
      "dataType": "Text (15)",
      "mandatory": "Yes",
      "validation": "Unique short code used on production and dispatch documents.",
      "sampleEntry": "PLANT-01",
      "section": 2
    },
    {
      "ref": "2.4",
      "field": "Plant address (full)",
      "dataType": "Text (300)",
      "mandatory": "Yes",
      "validation": "Complete site address including city, province and postal code.",
      "sampleEntry": "Deh Kohistan, Main Super Highway, Nooriabad, Jamshoro, Sindh 76100",
      "section": 2
    },
    {
      "ref": "2.5",
      "field": "Plant city / province",
      "dataType": "Text (80)",
      "mandatory": "Yes",
      "validation": "Master list of Pakistani cities and provinces.",
      "sampleEntry": "Nooriabad / Sindh",
      "section": 2
    },
    {
      "ref": "2.6",
      "field": "Plant geo-coordinates (lat, long)",
      "dataType": "Text (30)",
      "mandatory": "No",
      "validation": "Decimal degrees; used for delivery routing.",
      "sampleEntry": "25.1408, 67.8985",
      "section": 2
    },
    {
      "ref": "2.7",
      "field": "Plant Manager - full name & designation",
      "dataType": "Text (150)",
      "mandatory": "Yes",
      "validation": "Person overall in charge of the site.",
      "sampleEntry": "Engr. Tariq Mahmood / Plant Manager",
      "section": 2
    },
    {
      "ref": "2.8",
      "field": "Plant Manager - mobile",
      "dataType": "Phone",
      "mandatory": "Yes",
      "validation": "+92-3XX-XXXXXXX",
      "sampleEntry": "+92-300-8877665",
      "section": 2
    },
    {
      "ref": "2.9",
      "field": "Production Manager - full name & designation",
      "dataType": "Text (150)",
      "mandatory": "Yes",
      "validation": "Person responsible for production planning and output.",
      "sampleEntry": "Engr. Saad Rehman / Production Manager",
      "section": 2
    },
    {
      "ref": "2.10",
      "field": "Production Manager - mobile",
      "dataType": "Phone",
      "mandatory": "Yes",
      "validation": "+92-3XX-XXXXXXX",
      "sampleEntry": "+92-321-4433221",
      "section": 2
    },
    {
      "ref": "2.11",
      "field": "Plant landline / control room number",
      "dataType": "Phone",
      "mandatory": "No",
      "validation": "Format +92-XX-XXXXXXXX ext. NNN",
      "sampleEntry": "+92-25-4670011 ext. 105",
      "section": 2
    },
    {
      "ref": "2.12",
      "field": "Products manufactured at this plant",
      "dataType": "Multi-select",
      "mandatory": "Yes",
      "validation": "Linked to the material master, e.g. OPC 43 / OPC 53 / SRC / Slag Cement / Clinker.",
      "sampleEntry": "OPC 53, SRC, Clinker",
      "section": 2
    },
    {
      "ref": "2.13",
      "field": "Plant operational status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Operational / Under maintenance / Under construction / Closed - with effective date.",
      "sampleEntry": "Operational",
      "section": 2
    },
    {
      "ref": "3.1",
      "field": "Full name",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "As per CNIC.",
      "sampleEntry": "Kamran Baig",
      "section": 3
    },
    {
      "ref": "3.2",
      "field": "Designation",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Free text.",
      "sampleEntry": "General Manager Sales",
      "section": 3
    },
    {
      "ref": "3.3",
      "field": "Mobile number",
      "dataType": "Phone",
      "mandatory": "Yes",
      "validation": "+92-3XX-XXXXXXX; must be unique per contact.",
      "sampleEntry": "+92-333-1122334",
      "section": 3
    },
    {
      "ref": "4.1",
      "field": "Bank name",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "SBP-licensed scheduled bank.",
      "sampleEntry": "Habib Bank Limited",
      "section": 4
    },
    {
      "ref": "4.2",
      "field": "Title of account",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "Must match the registered legal name in field 1.1; mismatches block payment release.",
      "sampleEntry": "Pak Cement Industries Limited",
      "section": 4
    },
    {
      "ref": "4.3",
      "field": "Account number",
      "dataType": "Text (20)",
      "mandatory": "Yes",
      "validation": "Numeric, as issued by the bank, allow 0 in the start.",
      "sampleEntry": "7867900123456",
      "section": 4
    },
    {
      "ref": "5.1",
      "field": "Working days per week",
      "dataType": "Multi-select",
      "mandatory": "Yes",
      "validation": "Mon / Tue / Wed / Thu / Fri / Sat / Sun - drives delivery-date calculation in the ERP.",
      "sampleEntry": "Mon, Tue, Wed, Thu, Fri, Sat",
      "section": 5
    },
    {
      "ref": "5.2",
      "field": "Weekly off day(s)",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Sunday (default) / Friday / Other. Orders are not scheduled on off days.",
      "sampleEntry": "Sunday",
      "section": 5
    },
    {
      "ref": "5.3",
      "field": "Plant operating pattern",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "24x7 continuous / Two shifts / Single shift.",
      "sampleEntry": "24x7 continuous",
      "section": 5
    },
    {
      "ref": "5.4",
      "field": "Shift timings",
      "dataType": "Text (120)",
      "mandatory": "Yes",
      "validation": "Allow multiple shifts, all shifts with start and end times.",
      "sampleEntry": "A 06:00-14:00, B 14:00-22:00, C 22:00-06:00",
      "section": 5
    },
    {
      "ref": "5.5",
      "field": "Dispatch / loading hours",
      "dataType": "Text (80)",
      "mandatory": "Yes",
      "validation": "Gate-in to gate-out window for collection vehicles.",
      "sampleEntry": "06:00-22:00 PKT",
      "section": 5
    },
    {
      "ref": "5.6",
      "field": "Order cut-off time for same-day dispatch",
      "dataType": "Time",
      "mandatory": "Yes",
      "validation": "Orders received after this time are scheduled for the next working day.",
      "sampleEntry": "14:00 PKT",
      "section": 5
    },
    {
      "ref": "5.7",
      "field": "Office / commercial working hours",
      "dataType": "Text (80)",
      "mandatory": "Yes",
      "validation": "Applies to sales, finance and documentation teams.",
      "sampleEntry": "Mon-Sat 09:00-17:30 PKT",
      "section": 5
    },
    {
      "ref": "5.8",
      "field": "Annual maintenance shutdown period",
      "dataType": "Date range",
      "mandatory": "Yes",
      "validation": "Planned shutdown; the ERP blocks delivery promises in this window.",
      "sampleEntry": "15-Jan-2027 to 05-Feb-2027",
      "section": 5
    },
    {
      "ref": "5.9",
      "field": "Public / religious holidays observed",
      "dataType": "Multi-select",
      "mandatory": "Yes",
      "validation": "Gazetted Pakistan holidays plus Eid-ul-Fitr, Eid-ul-Azha and Muharram closures.",
      "sampleEntry": "Gazetted holidays + 3 days Eid-ul-Fitr",
      "section": 5
    },
    {
      "ref": "5.10",
      "field": "Ramadan / seasonal timing changes",
      "dataType": "Text (120)",
      "mandatory": "No",
      "validation": "Reduced hours during Ramadan or the monsoon season.",
      "sampleEntry": "Ramadan: dispatch 06:00-16:00",
      "section": 5
    },
    {
      "ref": "5.11",
      "field": "Emergency / after-hours dispatch available?",
      "dataType": "Yes / No",
      "mandatory": "Yes",
      "validation": "If Yes, provide the after-hours contact and any surcharge.",
      "sampleEntry": "Yes - Level 2 contact, 5% surcharge",
      "section": 5
    },
    {
      "ref": "5.12",
      "field": "Calendar applies to (plant)",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Calendars can be maintained per plant; select 'All plants' for a single common calendar.",
      "sampleEntry": "PLANT-01",
      "section": 5
    },
    {
      "ref": "5.13",
      "field": "Calendar effective from / to",
      "dataType": "Date range",
      "mandatory": "Yes",
      "validation": "The working calendar is versioned; the ERP applies the version valid on the order date.",
      "sampleEntry": "01-Jul-2026 to 30-Jun-2027",
      "section": 5
    },
    {
      "ref": "6.1",
      "field": "Name of product",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Linked to the material master, e.g. OPC 43 / OPC 53 / SRC / Slag Cement / Clinker. One line per product.",
      "sampleEntry": "OPC 53 Grade",
      "section": 6
    },
    {
      "ref": "6.2",
      "field": "Unit of measure (UoM)",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "From the UoM master: 50 kg bag / MT / 1.2 MT jumbo bag / Bulk.",
      "sampleEntry": "50 kg bag",
      "section": 6
    },
    {
      "ref": "6.3",
      "field": "Price per UoM (PKR)",
      "dataType": "Number",
      "mandatory": "Yes",
      "validation": "Excluding sales tax; must be greater than zero. Tax lines are computed by the ERP.",
      "sampleEntry": "1420",
      "section": 6
    },
    {
      "ref": "6.4",
      "field": "Discount",
      "dataType": "Number / %",
      "mandatory": "No",
      "validation": "PKR per UoM or % of price; cannot exceed the price in 6.3.",
      "sampleEntry": "2%",
      "section": 6
    },
    {
      "ref": "6.5",
      "field": "Discount validity (from / to)",
      "dataType": "Date range",
      "mandatory": "Yes, if 6.4 is entered",
      "validation": "DATE FIELD - 'to' date must be on or after the 'from' date; the discount stops applying after the 'to' date.",
      "sampleEntry": "01-Oct-2026 to 31-Dec-2026",
      "section": 6
    },
    {
      "ref": "7.1",
      "field": "Exemption availed?",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Yes / No. If No, normal withholding rates apply based on the filer status in field 1.4.",
      "sampleEntry": "Yes",
      "section": 7
    },
    {
      "ref": "7.2",
      "field": "Exemption validity (from / to)",
      "dataType": "Date range",
      "mandatory": "Yes, if 7.1 = Yes",
      "validation": "DATE FIELD - 'to' date must be on or after the 'from' date; amber 30 days before expiry, red once expired. After expiry the ERP applies normal withholding rates automatically.",
      "sampleEntry": "01-Jul-2026 to 30-Jun-2027",
      "section": 7
    },
    {
      "ref": "7.3",
      "field": "Withholding tax rate during exemption (%)",
      "dataType": "Number / %",
      "mandatory": "Yes, if 7.1 = Yes",
      "validation": "0% for full exemption, or the reduced rate allowed; applied only to bills dated within the validity in 7.2.",
      "sampleEntry": "0%",
      "section": 7
    }
  ]
}