      "sampleEntry": "46204",
      "section": 2
    },
    {
      "ref": "2.14",
      "field": "Exemption certificate - valid until",
      "dataType": "Date",
      "mandatory": "Conditional",
      "validation": "EDITABLE / UPDATED PERIODICALLY. After this date the ERP stops applying the exemption and resumes normal withholding automatically.",
