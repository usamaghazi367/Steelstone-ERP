      "sampleEntry": "46235",
      "section": 2
    },
    {
      "ref": "2.6",
      "field": "Filer status - valid until (next verification due)",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "EDITABLE / UPDATED PERIODICALLY. On expiry the ERP flags the supplier and reverts to non-filer WHT rates until re-verified.",
      "sampleEntry": "46326",
      "section": 2
    },
    {
      "ref": "2.7",
      "field": "ATL re-verification frequency",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Monthly / Quarterly / Half-yearly. System raises an alert to the procurement team on the due date.",
      "sampleEntry": "Quarterly",
      "section": 2
    },
    {
      "ref": "2.8",
      "field": "Provincial revenue authority & registration no.",
      "dataType": "Text (60)",
