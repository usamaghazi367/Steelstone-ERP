      "validation": "PRA / SRB / KPRA / BRA registration where services are also rendered (e.g. transport).",
      "sampleEntry": "SRB - SRB-98-76-5432",
      "section": 2
    },
    {
      "ref": "2.9",
      "field": "Federal Excise Duty (FED) registration",
