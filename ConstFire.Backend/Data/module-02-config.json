      "sampleEntry": "3277800098765",
      "section": 2
    },
    {
      "ref": "2.3",
      "field": "Sales tax registration category",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Manufacturer / Importer / Wholesaler / Retailer / Exporter. Must include Manufacturer.",
      "sampleEntry": "Manufacturer",
      "section": 2
    },
    {
      "ref": "2.4",
      "field": "FBR filer status (Active Taxpayer List)",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Filer / Non-filer - drives the withholding tax rate applied on payments.",
      "sampleEntry": "Filer",
      "section": 2
    },
    {
      "ref": "2.5",
      "field": "Filer status - date last verified against ATL",
