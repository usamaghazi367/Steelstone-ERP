      "validation": "Must match the Certificate of Incorporation, Form II or NTN certificate exactly.",
      "sampleEntry": "Al-Karam Traders",
      "section": 1
    },
    {
      "ref": "1.8",
      "field": "Trading / business name",
      "dataType": "Text (100)",
