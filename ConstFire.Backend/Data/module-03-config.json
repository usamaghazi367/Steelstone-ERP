{
  "code": "03",
  "name": "DISTRIBUTOR REGISTRATION",
  "category": "ERP Module",
  "recordCodePrefix": "DST",
  "listColumns": [
    "_recordCode",
    "1.1",
    "1.2",
    "1.3"
  ],
  "sections": [
    {
      "num": 1,
      "title": "BUSINESS REGISTRATION",
      "repeating": false
    },
    {
      "num": 2,
      "title": "POINTS OF CONTACT  (repeating block - minimum 2, unlimited additional contacts)",
      "repeating": true
    },
    {
      "num": 3,
      "title": "BANK ACCOUNT DETAILS  (repeating block - multiple accounts supported)",
      "repeating": true
    },
    {
      "num": 4,
      "title": "PAYMENT TERMS",
      "repeating": false
    }
  ],
  "fields": [
    {
      "ref": "1.1",
      "field": "Business name (Title)",
      "dataType": "Text (150)",
      "mandatory": "Yes",
      "validation": "Registered name as per SECP / Registrar of Firms / FBR NTN record; for a sole proprietor or individual, the name as per CNIC.",
      "sampleEntry": "Al-Karam Traders",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Legal status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Company / AOP / Sole Proprietor / Individual. Determines whether NTN or CNIC is required in field 1.3.",
      "sampleEntry": "AOP",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "NTN / CNIC number",
      "dataType": "Text (15)",
      "mandatory": "Yes",
      "validation": "Company and AOP: NTN - 7 digits + '-' + check digit. Sole Proprietor and Individual: 13-digit CNIC (XXXXX-XXXXXXX-X) in lieu of NTN. Unique per record.",
      "sampleEntry": "2233445-6",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Filer status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Filer / Non-filer as per the FBR Active Taxpayer List - drives the withholding tax rates applied in the ERP.",
      "sampleEntry": "Filer",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Full name",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "As per CNIC.",
      "sampleEntry": "Muhammad Aslam",
      "section": 2
    },
    {
      "ref": "2.2",
      "field": "Designation",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Free text.",
      "sampleEntry": "Managing Partner",
      "section": 2
    },
    {
      "ref": "2.3",
      "field": "Mobile number",
      "dataType": "Phone",
      "mandatory": "Yes",
      "validation": "+92-3XX-XXXXXXX; must be unique per contact.",
      "sampleEntry": "+92-300-8765432",
      "section": 2
    },
    {
      "ref": "3.1",
      "field": "Bank name",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "SBP-licensed scheduled bank.",
      "sampleEntry": "Bank Alfalah Limited",
      "section": 3
    },
    {
      "ref": "3.2",
      "field": "Title of account",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "Must match the registered legal name in field 1.1; mismatches block refunds and rebates.",
      "sampleEntry": "Al-Karam Traders",
      "section": 3
    },
    {
      "ref": "3.3",
      "field": "Account number",
      "dataType": "Text (20)",
      "mandatory": "Yes",
      "validation": "Numeric, as issued by the bank, allow 0 at Start",
      "sampleEntry": "4550010098765",
      "section": 3
    },
    {
      "ref": "4.1",
      "field": "Payment terms",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Advance / Cash on delivery / Net 7 / Net 15 / Net 30 / Net 45.",
      "sampleEntry": "Net 30",
      "section": 4
    },
    {
      "ref": "4.2",
      "field": "Early payment / prompt settlement discount",
      "dataType": "Percentage",
      "mandatory": "No",
      "validation": "Discount and qualifying days.",
      "sampleEntry": "1.0% within 10 days",
      "section": 4
    }
  ]
}