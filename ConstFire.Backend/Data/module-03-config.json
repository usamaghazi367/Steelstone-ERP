  "fields": [
    {
      "ref": "1.1",
      "field": "Distributor code",
      "dataType": "Text (10)",
      "mandatory": "System",
      "validation": "Auto-generated, unique and immutable (e.g. DIST-00001).",
      "sampleEntry": "DIST-00034",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Registering enterprise (principal)",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Links this distributor to the enterprise registered on sheet 01.",
      "sampleEntry": "ENT-000145 - Steelstone IT (Pvt) Ltd",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "Is the distributor registered with SECP? (ENTITY-TYPE CHECK)",
      "dataType": "Yes / No",
      "mandatory": "Yes",
      "validation": "GATING FIELD - answered first. Yes = Company track; No = AOP / Firm / Sole Proprietor track.",
      "sampleEntry": "No",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Registering authority",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "SECP / Registrar of Firms (Provincial) / FBR only (Sole Proprietor). Must be SECP if 1.3 = Yes.",
      "sampleEntry": "Registrar of Firms (Provincial)",
      "section": 1
    },
    {
      "ref": "1.5",
      "field": "Entity class (system-derived)",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Derived from 1.3 and 1.4; enforces every conditional rule below.",
      "sampleEntry": "AOP / Partnership Firm",
      "section": 1
    },
    {
      "ref": "1.6",
      "field": "Legal status / entity type",
      "dataType": "Dependent dropdown",
      "mandatory": "Yes",
      "validation": "Company: SMC-Private / Private Limited / Public Limited. AOP: Registered Partnership Firm / Unregistered AOP. Other: Sole Proprietorship.",
      "sampleEntry": "Registered Partnership Firm",
      "section": 1
    },
    {
      "ref": "1.7",
      "field": "Registered legal name",
      "dataType": "Text (150)",
