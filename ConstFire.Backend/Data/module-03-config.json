      "sampleEntry": "3277822334456",
      "section": 2
    },
    {
      "ref": "2.3",
      "field": "Sales tax registration category",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Distributor / Wholesaler / Dealer / Retailer / Unregistered.",
      "sampleEntry": "Distributor",
      "section": 2
    },
    {
      "ref": "2.4",
      "field": "FBR filer status (Active Taxpayer List)",
