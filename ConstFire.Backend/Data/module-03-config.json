      "sampleEntry": "46235",
      "section": 2
    },
    {
      "ref": "2.6",
      "field": "Filer status - valid until (next verification due)",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "EDITABLE / UPDATED PERIODICALLY. On expiry the ERP flags the account and applies non-filer rates until re-verified.",
      "sampleEntry": "46326",
      "section": 2
    },
    {
      "ref": "2.7",
      "field": "FBR filer status - status flag (system-derived)",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Active while the date in field 2.6 is in the future. INACTIVE BY DEFAULT once it passes - non-filer withholding rates apply until the status is re-verified.",
