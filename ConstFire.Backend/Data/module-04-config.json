{
  "code": "04",
  "name": "CUSTOMER REGISTRATION - END USER",
  "category": "ERP Module",
  "recordCodePrefix": "CUS",
  "listColumns": [
    "_recordCode",
    "1.1",
    "1.2",
    "1.3"
  ],
  "sections": [
    {
      "num": 1,
      "title": "BUSINESS REGISTRATION",
      "repeating": false
    },
    {
      "num": 2,
      "title": "DELIVERY MODE SELECTION  (bag / bulker / both - controls Sections 3 and 4)",
      "repeating": false
    },
    {
      "num": 3,
      "title": "BAG DELIVERY POINTS  (repeating - default 1, unlimited additional points)",
      "repeating": false
    },
    {
      "num": 4,
      "title": "BULKER DELIVERY POINTS  (repeating - default 1, unlimited additional points)",
      "repeating": false
    },
    {
      "num": 5,
      "title": "POINTS OF CONTACT  (repeating block - minimum 2, unlimited additional contacts)",
      "repeating": true
    },
    {
      "num": 6,
      "title": "BANK ACCOUNT DETAILS  (repeating block - multiple accounts supported)",
      "repeating": true
    },
    {
      "num": 7,
      "title": "EXEMPTION CERTIFICATES  (repeating block - one row set per certificate)",
      "repeating": true
    }
  ],
  "fields": [
    {
      "ref": "1.1",
      "field": "Business name (Title)",
      "dataType": "Text (150)",
      "mandatory": "Yes",
      "validation": "Registered name as per SECP / Registrar of Firms / FBR NTN record; for a sole proprietor or individual, the name as per CNIC.",
      "sampleEntry": "Zameen Builders (Private) Limited",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Legal status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Company / AOP / Sole Proprietor / Individual. Determines whether NTN or CNIC is required in field 1.3.",
      "sampleEntry": "Company",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "NTN / CNIC number",
      "dataType": "Text (15)",
      "mandatory": "Yes",
      "validation": "Company and AOP: NTN - 7 digits + '-' + check digit. Sole Proprietor and Individual: 13-digit CNIC (XXXXX-XXXXXXX-X) in lieu of NTN. Unique per record.",
      "sampleEntry": "0077331-2",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Filer status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Filer / Non-filer as per the FBR Active Taxpayer List - drives the withholding tax rates applied in the ERP.",
      "sampleEntry": "Filer",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Delivery mode required (DELIVERY-TYPE CHECK)",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "GATING FIELD - Bag only / Bulker only / Both. Bag = Section 3 opens; Bulker = Section 4 opens; Both = Sections 3 and 4 open. The unselected section stays hidden and is NOT required.",
      "sampleEntry": "Both",
      "section": 2
    },
    {
      "ref": "2.2",
      "field": "Number of bag delivery points",
      "dataType": "Integer",
      "mandatory": "Conditional",
      "validation": "Default 1. Additional points can be added without limit. Required only if 2.1 = Bag only or Both.",
      "sampleEntry": "2",
      "section": 2
    },
    {
      "ref": "2.3",
      "field": "Number of bulker delivery points",
      "dataType": "Integer",
      "mandatory": "Conditional",
      "validation": "Default 1. Additional points can be added without limit. Required only if 2.1 = Bulker only or Both.",
      "sampleEntry": "1",
      "section": 2
    },
    {
      "ref": "2.4",
      "field": "Delivery basis / Incoterm",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Ex-works collection by customer / Delivered at site (FOR) / Free on truck at plant.",
      "sampleEntry": "Delivered at site (FOR)",
      "section": 2
    },
    {
      "ref": "2.5",
      "field": "Transport arrangement",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Arranged by seller / Arranged by customer / Third-party transporter nominated by customer.",
      "sampleEntry": "Arranged by seller",
      "section": 2
    },
    {
      "ref": "2.6",
      "field": "Preferred delivery days",
      "dataType": "Multi-select",
      "mandatory": "Yes",
      "validation": "Mon / Tue / Wed / Thu / Fri / Sat / Sun - used for delivery scheduling.",
      "sampleEntry": "Mon, Tue, Wed, Thu, Fri, Sat",
      "section": 2
    },
    {
      "ref": "2.7",
      "field": "Preferred delivery time window",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Site receiving window; deliveries are not scheduled outside it.",
      "sampleEntry": "08:00-18:00 PKT",
      "section": 2
    },
    {
      "ref": "2.8",
      "field": "Advance notice required before delivery (hours)",
      "dataType": "Integer",
      "mandatory": "Yes",
      "validation": "Notice the site needs before a vehicle arrives.",
      "sampleEntry": "24",
      "section": 2
    },
    {
      "ref": "2.9",
      "field": "Site access constraints",
      "dataType": "Text (200)",
      "mandatory": "No",
      "validation": "Vehicle size limits, city entry timing bans, permits, weight restrictions, narrow approach.",
      "sampleEntry": "No entry 07:00-10:00 (city ban); max 22-wheeler",
      "section": 2
    },
    {
      "ref": "2.10",
      "field": "Delivery documentation required at gate",
      "dataType": "Multi-select",
      "mandatory": "Yes",
      "validation": "Delivery challan / Weighbridge slip / Mill test certificate / Gate pass / Tax invoice.",
      "sampleEntry": "Delivery challan, Weighbridge slip, Tax invoice",
      "section": 2
    },
    {
      "ref": "3.1",
      "field": "Bag delivery point serial no.",
      "dataType": "Integer",
      "mandatory": "Conditional",
      "validation": "REPEATING BLOCK - applies only when field 2.1 includes Bag. Point 1 is created by default; more can be added without limit.",
      "sampleEntry": "1",
      "section": 3
    },
    {
      "ref": "3.2",
      "field": "Delivery point name / code",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Unique per customer; printed on the delivery challan.",
      "sampleEntry": "BAG-01 Site Store, DHA Phase 8",
      "section": 3
    },
    {
      "ref": "3.3",
      "field": "Address line 1",
      "dataType": "Text (150)",
      "mandatory": "Yes",
      "validation": "Street / plot / survey number.",
      "sampleEntry": "Plot 145, Sector Z, DHA Phase 8",
      "section": 3
    },
    {
      "ref": "3.4",
      "field": "Address line 2 / landmark",
      "dataType": "Text (150)",
      "mandatory": "No",
      "validation": "Nearest landmark to assist the driver.",
      "sampleEntry": "Opposite Rahbar Grid Station",
      "section": 3
    },
    {
      "ref": "3.5",
      "field": "City / District",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Master list of Pakistani cities and districts.",
      "sampleEntry": "Lahore / Lahore",
      "section": 3
    },
    {
      "ref": "3.6",
      "field": "Province",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Punjab / Sindh / KPK / Balochistan / Gilgit-Baltistan / AJK / ICT",
      "sampleEntry": "Punjab",
      "section": 3
    },
    {
      "ref": "3.7",
      "field": "Geo-coordinates (lat, long)",
      "dataType": "Text (30)",
      "mandatory": "No",
      "validation": "Decimal degrees; used for freight distance and driver routing.",
      "sampleEntry": "31.4520, 74.4110",
      "section": 3
    },
    {
      "ref": "3.8",
      "field": "Site contact - name & mobile",
      "dataType": "Text (120)",
      "mandatory": "Yes",
      "validation": "Person who receives the material and signs the delivery challan.",
      "sampleEntry": "Rashid Ali / +92-333-4455667",
      "section": 3
    },
    {
      "ref": "3.9",
      "field": "Receiving hours at this point",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "May differ from the general window in field 2.7.",
      "sampleEntry": "09:00-17:00 PKT",
      "section": 3
    },
    {
      "ref": "3.10",
      "field": "Covered storage available & capacity (bags)",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Godown or covered shed capacity in 50 kg bags.",
      "sampleEntry": "Covered shed - 8,000 bags",
      "section": 3
    },
    {
      "ref": "3.11",
      "field": "Unloading labour provided by",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Customer / Seller / Transporter - determines who bears the unloading cost.",
      "sampleEntry": "Customer",
      "section": 3
    },
    {
      "ref": "3.12",
      "field": "Largest vehicle that can access the site",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Mazda (7 MT) / 10-wheeler (18 MT) / 22-wheeler (35 MT) - the ERP restricts vehicle allocation accordingly.",
      "sampleEntry": "10-wheeler (18 MT)",
      "section": 3
    },
    {
      "ref": "3.13",
      "field": "Is this the default bag delivery point?",
      "dataType": "Yes / No",
      "mandatory": "Yes",
      "validation": "Exactly one bag point must be flagged default; it is pre-selected on every order.",
      "sampleEntry": "Yes",
      "section": 3
    },
    {
      "ref": "3.14",
      "field": "Delivery point status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Active / Inactive with effective date. Inactive points cannot be selected on new orders.",
      "sampleEntry": "Active",
      "section": 3
    },
    {
      "ref": "4.1",
      "field": "Delivery point name",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "REPEATING BLOCK - applies only when field 2.1 includes Bulker. Unique per customer; printed on the delivery challan.",
      "sampleEntry": "BULK-01 Batching Plant, Raiwind",
      "section": 4
    },
    {
      "ref": "4.2",
      "field": "Address",
      "dataType": "Text (250)",
      "mandatory": "Yes",
      "validation": "Full site address including city and province.",
      "sampleEntry": "Plot 22, Sundar Industrial Estate, Raiwind Road, Lahore, Punjab",
      "section": 4
    },
    {
      "ref": "4.3",
      "field": "POC name",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "Person at the site who receives the material and supervises silo discharge.",
      "sampleEntry": "Engr. Umar Farooq",
      "section": 4
    },
    {
      "ref": "4.4",
      "field": "Mobile number",
      "dataType": "Phone",
      "mandatory": "Yes",
      "validation": "+92-3XX-XXXXXXX",
      "sampleEntry": "+92-321-4455667",
      "section": 4
    },
    {
      "ref": "5.1",
      "field": "Full name",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "As per CNIC.",
      "sampleEntry": "Bilal Nadeem",
      "section": 5
    },
    {
      "ref": "5.2",
      "field": "Designation",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Free text.",
      "sampleEntry": "Procurement Manager",
      "section": 5
    },
    {
      "ref": "5.3",
      "field": "Mobile number",
      "dataType": "Phone",
      "mandatory": "Yes",
      "validation": "+92-3XX-XXXXXXX; must be unique per contact.",
      "sampleEntry": "+92-300-1239876",
      "section": 5
    },
    {
      "ref": "6.1",
      "field": "Bank name",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "SBP-licensed scheduled bank.",
      "sampleEntry": "United Bank Limited",
      "section": 6
    },
    {
      "ref": "6.2",
      "field": "Title of account",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "Must match the registered legal name in field 1.1; mismatches block refunds and credit notes.",
      "sampleEntry": "Zameen Builders (Private) Limited",
      "section": 6
    },
    {
      "ref": "6.3",
      "field": "Account number",
      "dataType": "Text (20)",
      "mandatory": "Yes",
      "validation": "Numeric as issued by the bank; leading zeros are preserved.",
      "sampleEntry": "3120010055443",
      "section": 6
    },
    {
      "ref": "7.1",
      "field": "Certificate number",
      "dataType": "Text (40)",
      "mandatory": "Yes",
      "validation": "As issued by the Commissioner Inland Revenue or the provincial authority.",
      "sampleEntry": "EXM-159/2026/0455",
      "section": 7
    },
    {
      "ref": "7.2",
      "field": "Issuing authority / tax office",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "CIR zone, RTO / LTO, or provincial revenue authority.",
      "sampleEntry": "CIR Zone-I, RTO Lahore",
      "section": 7
    },
    {
      "ref": "7.3",
      "field": "Section / statutory reference",
      "dataType": "Text (40)",
      "mandatory": "Yes",
      "validation": "Section of the Income Tax Ordinance 2001 or the Sales Tax Act 1990 relied upon.",
      "sampleEntry": "Section 159(1)",
      "section": 7
    },
    {
      "ref": "7.4",
      "field": "Applicable tax type & normal rate",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Tax the certificate relates to and the standard rate that would otherwise apply.",
      "sampleEntry": "Income tax WHT, normal 4.5%",
      "section": 7
    },
    {
      "ref": "7.5",
      "field": "Exempted / reduced rate granted",
      "dataType": "Percentage",
      "mandatory": "Yes",
      "validation": "Rate the ERP applies while the certificate is valid.",
      "sampleEntry": "0",
      "section": 7
    },
    {
      "ref": "7.6",
      "field": "Valid from",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "Start date of the exemption period.",
      "sampleEntry": "46204",
      "section": 7
    },
    {
      "ref": "7.7",
      "field": "Valid until",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "EDITABLE / UPDATED PERIODICALLY. After this date the ERP automatically resumes the normal rate and alerts finance.",
      "sampleEntry": "46568",
      "section": 7
    },
    {
      "ref": "7.8",
      "field": "Renewal reminder lead time (days)",
      "dataType": "Integer",
      "mandatory": "Yes",
      "validation": "Days before expiry that the system notifies the customer and the finance team.",
      "sampleEntry": "30",
      "section": 7
    },
    {
      "ref": "7.9",
      "field": "Certificate copy attached",
      "dataType": "File upload",
      "mandatory": "Yes",
      "validation": "PDF, max 5 MB; verified against the FBR portal before activation.",
      "sampleEntry": "Attached",
      "section": 7
    },
    {
      "ref": "7.10",
      "field": "Verified by & date (internal)",
      "dataType": "Text (100)",
      "mandatory": "Internal",
      "validation": "Finance officer who verified the certificate with the issuing authority.",
      "sampleEntry": "Finance - A. Malik, 05-Aug-2026",
      "section": 7
    },
    {
      "ref": "7.11",
      "field": "Certificate status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Active / Expired / Withdrawn / Under renewal. Set automatically from the valid-until date - INACTIVE BY DEFAULT after expiry, and the ERP resumes the normal tax rate on every invoice.",
      "sampleEntry": "Active",
      "section": 7
    }
  ]
}