      "sampleEntry": "ENT-000145 - Steelstone IT (Pvt) Ltd",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "Customer constitution (ENTITY-TYPE CHECK)",
      "dataType": "Dropdown",
