{
  "code": "05",
  "name": "TRANSPORTER REGISTRATION",
  "category": "ERP Module",
  "recordCodePrefix": "TRN",
  "listColumns": [
    "_recordCode",
    "1.1",
    "1.2",
    "1.3"
  ],
  "sections": [
    {
      "num": 1,
      "title": "BUSINESS REGISTRATION",
      "repeating": false
    },
    {
      "num": 2,
      "title": "POINTS OF CONTACT  (repeating block - minimum 2, unlimited additional contacts)",
      "repeating": true
    },
    {
      "num": 3,
      "title": "BANK ACCOUNT DETAILS  (repeating block - multiple accounts supported)",
      "repeating": true
    },
    {
      "num": 4,
      "title": "WITHHOLDING TAX EXEMPTION",
      "repeating": false
    }
  ],
  "fields": [
    {
      "ref": "1.1",
      "field": "Business name (Title)",
      "dataType": "Text (150)",
      "mandatory": "Yes",
      "validation": "Registered name as per SECP / Registrar of Firms / FBR NTN record; for a sole proprietor or individual, the name as per CNIC.",
      "sampleEntry": "Shaheen Goods Transport Company",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Legal status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Company / AOP / Sole Proprietor / Individual. Determines whether NTN or CNIC is required in field 1.3.",
      "sampleEntry": "AOP",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "NTN / CNIC number",
      "dataType": "Text (15)",
      "mandatory": "Yes",
      "validation": "Company and AOP: NTN - 7 digits + '-' + check digit. Sole Proprietor and Individual: 13-digit CNIC (XXXXX-XXXXXXX-X) in lieu of NTN. Unique per record.",
      "sampleEntry": "3344556-7",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Filer status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Filer / Non-filer as per the FBR Active Taxpayer List - drives the withholding tax rates applied in the ERP.",
      "sampleEntry": "Filer",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Full name",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "As per CNIC.",
      "sampleEntry": "Shahid Mehmood",
      "section": 2
    },
    {
      "ref": "2.2",
      "field": "Designation",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Free text.",
      "sampleEntry": "Fleet Operations Manager",
      "section": 2
    },
    {
      "ref": "2.3",
      "field": "Mobile number",
      "dataType": "Phone",
      "mandatory": "Yes",
      "validation": "+92-3XX-XXXXXXX; must be unique per contact.",
      "sampleEntry": "+92-321-2233445",
      "section": 2
    },
    {
      "ref": "3.1",
      "field": "Bank name",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "SBP-licensed scheduled bank.",
      "sampleEntry": "MCB Bank Limited",
      "section": 3
    },
    {
      "ref": "3.2",
      "field": "Title of account",
      "dataType": "Text (100)",
      "mandatory": "Yes",
      "validation": "Must match the registered legal name in field 1.1; mismatches block freight payments.",
      "sampleEntry": "Shaheen Goods Transport Company",
      "section": 3
    },
    {
      "ref": "3.3",
      "field": "Account number",
      "dataType": "Text (20)",
      "mandatory": "Yes",
      "validation": "Numeric as issued by the bank; leading zeros are preserved.",
      "sampleEntry": "2190010077331",
      "section": 3
    },
    {
      "ref": "4.1",
      "field": "Exemption availed?",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Yes / No. If No, normal withholding rates apply based on the filer status in field 1.4.",
      "sampleEntry": "Yes",
      "section": 4
    },
    {
      "ref": "4.2",
      "field": "Exemption validity (from / to)",
      "dataType": "Date range",
      "mandatory": "Yes, if 4.1 = Yes",
      "validation": "DATE FIELD - 'to' date must be on or after the 'from' date; amber 30 days before expiry, red once expired. After expiry the ERP applies normal withholding rates automatically.",
      "sampleEntry": "01-Jul-2026 to 30-Jun-2027",
      "section": 4
    },
    {
      "ref": "4.3",
      "field": "Withholding tax rate during exemption (%)",
      "dataType": "Number / %",
      "mandatory": "Yes, if 4.1 = Yes",
      "validation": "0% for full exemption, or the reduced rate allowed; applied only to bills dated within the validity in 4.2.",
      "sampleEntry": "0%",
      "section": 4
    }
  ]
}