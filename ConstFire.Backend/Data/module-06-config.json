{
  "code": "06",
  "name": "VEHICLE REGISTRATION",
  "category": "ERP Module",
  "recordCodePrefix": "VDR",
  "listColumns": [
    "_recordCode",
    "1.1",
    "1.2",
    "1.3"
  ],
  "sections": [
    {
      "num": 1,
      "title": "VEHICLE IDENTIFICATION & REGISTRATION  (repeating register - unlimited vehicles)",
      "repeating": false
    },
    {
      "num": 2,
      "title": "VEHICLE STATUTORY DOCUMENTS & VALIDITY",
      "repeating": false
    }
  ],
  "fields": [
    {
      "ref": "1.1",
      "field": "Vehicle record code",
      "dataType": "Text (10)",
      "mandatory": "System",
      "validation": "Auto-generated, unique and immutable (e.g. VEH-00001). REPEATING REGISTER - unlimited vehicles.",
      "sampleEntry": "VEH-00042",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Owning transporter",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Select from the transporters registered on sheet 05, or 'Own fleet of enterprise'.",
      "sampleEntry": "TRN-00007 - Shaheen Goods Transport Company",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "Ownership type",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Enterprise owned / Transporter owned / Attached (third-party) / Leased / Hire purchase.",
      "sampleEntry": "Transporter owned",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Registered owner name & NTN",
      "dataType": "Text (120)",
      "mandatory": "Yes",
      "validation": "Owner exactly as printed in the registration book. For a sole-proprietor owner, the CNIC is entered in lieu of the NTN.",
      "sampleEntry": "Shaheen Goods Transport Co. / NTN 3344556-7",
      "section": 1
    },
    {
      "ref": "1.5",
      "field": "Vehicle registration number",
      "dataType": "Text (15)",
      "mandatory": "Yes",
      "validation": "Unique across the system; format as issued by the excise & taxation department.",
      "sampleEntry": "TLE-1234",
      "section": 1
    },
    {
      "ref": "1.6",
      "field": "Registering authority & province",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Excise, Taxation & Narcotics Control Department of the province of registration.",
      "sampleEntry": "E&T Department, Sindh",
      "section": 1
    },
    {
      "ref": "1.7",
      "field": "Date of registration",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "As printed on the registration book.",
      "sampleEntry": "43634",
      "section": 1
    },
    {
      "ref": "1.8",
      "field": "Registration book / smart card number",
      "dataType": "Text (25)",
      "mandatory": "Yes",
      "validation": "Number printed on the registration book or smart card.",
      "sampleEntry": "SC-SIN-2019-778812",
      "section": 1
    },
    {
      "ref": "1.9",
      "field": "Vehicle category",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Goods carriage / Prime mover with trailer / Tanker / Light commercial vehicle.",
      "sampleEntry": "Goods carriage",
      "section": 1
    },
    {
      "ref": "1.10",
      "field": "Vehicle type",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Bulk cement tanker (bulker) / Flatbed trailer / Open body truck / Tipper or dumper / Container trailer / Mazda or light truck.",
      "sampleEntry": "Bulk cement tanker (bulker)",
      "section": 1
    },
    {
      "ref": "1.11",
      "field": "Make & model",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Manufacturer and model designation.",
      "sampleEntry": "Hino FM2P",
      "section": 1
    },
    {
      "ref": "1.12",
      "field": "Year of manufacture",
      "dataType": "Integer",
      "mandatory": "Yes",
      "validation": "Four-digit year; vehicles older than the enterprise age policy are flagged at induction.",
      "sampleEntry": "2019",
      "section": 1
    },
    {
      "ref": "1.13",
      "field": "Chassis number",
      "dataType": "Text (25)",
      "mandatory": "Yes",
      "validation": "Must match the registration book; unique across the system.",
      "sampleEntry": "FM2PKKD-10245",
      "section": 1
    },
    {
      "ref": "1.14",
      "field": "Engine number",
      "dataType": "Text (25)",
      "mandatory": "Yes",
      "validation": "Must match the registration book.",
      "sampleEntry": "P11C-TH-88221",
      "section": 1
    },
    {
      "ref": "1.15",
      "field": "Colour",
      "dataType": "Text (20)",
      "mandatory": "No",
      "validation": "As printed in the registration book; assists gate identification.",
      "sampleEntry": "White",
      "section": 1
    },
    {
      "ref": "1.16",
      "field": "Registration status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Active / Transferred / Scrapped / Impounded - with effective date.",
      "sampleEntry": "Active",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Route permit number",
      "dataType": "Text (30)",
      "mandatory": "Yes",
      "validation": "Goods carriage route permit issued by the Provincial Transport Authority.",
      "sampleEntry": "RP-SIN-2024-4471",
      "section": 2
    },
    {
      "ref": "2.2",
      "field": "Route permit - valid until",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "DATE FIELD - amber 30 days before expiry, red once expired.",
      "sampleEntry": "46387",
      "section": 2
    },
    {
      "ref": "2.3",
      "field": "Route permit - status (system-derived)",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Active while valid. INACTIVE BY DEFAULT after expiry - the vehicle cannot be allocated at dispatch.",
      "sampleEntry": "Active",
      "section": 2
    },
    {
      "ref": "2.4",
      "field": "Fitness certificate number",
      "dataType": "Text (30)",
      "mandatory": "Yes",
      "validation": "Motor vehicle fitness certificate issued after inspection.",
      "sampleEntry": "FC-SIN-2026-1188",
      "section": 2
    },
    {
      "ref": "2.5",
      "field": "Fitness certificate - valid until",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "DATE FIELD - amber 30 days before expiry, red once expired.",
      "sampleEntry": "46295",
      "section": 2
    },
    {
      "ref": "2.6",
      "field": "Fitness certificate - status (system-derived)",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Active while valid. INACTIVE BY DEFAULT after expiry - the vehicle cannot be allocated at dispatch.",
      "sampleEntry": "Active",
      "section": 2
    },
    {
      "ref": "2.7",
      "field": "Token tax - paid up to",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "DATE FIELD - amber 30 days before expiry, red once expired.",
      "sampleEntry": "46568",
      "section": 2
    },
    {
      "ref": "2.8",
      "field": "Token tax - status (system-derived)",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Active while paid. INACTIVE BY DEFAULT once the paid-up date passes; a compliance alert is raised.",
      "sampleEntry": "Active",
      "section": 2
    }
  ]
}