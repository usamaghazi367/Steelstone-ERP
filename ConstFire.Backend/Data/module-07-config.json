    },
    {
      "num": 3,
      "title": "EMPLOYMENT & POSTING DETAILS",
      "repeating": false
    },
    {
      "num": 4,
      "title": "QUALIFICATION, EXPERIENCE & TRAINING",
      "repeating": false
    },
    {
      "num": 5,
      "title": "STATUTORY REGISTRATIONS & TAX",
      "repeating": false
    },
    {
      "num": 6,
      "title": "COMPENSATION & PAYROLL SETUP",
      "repeating": false
    },
    {
      "num": 7,
      "title": "BANK ACCOUNT DETAILS FOR SALARY",
      "repeating": false
    },
    {
      "num": 8,
      "title": "LEAVE, ATTENDANCE & WORKING CALENDAR",
      "repeating": false
    },
    {
      "num": 9,
      "title": "DRIVER DETAILS - LICENCE, MEDICAL & STATUTORY VERIFICATION  (opens only where the job title in field 3.2 is Driver)",
      "repeating": false
    }
  ],
  "fields": [
    {
      "ref": "1.1",
      "field": "Employee code",
      "dataType": "Text (10)",
      "mandatory": "System",
      "validation": "Auto-generated, unique and immutable (e.g. EMP-00001). REPEATING REGISTER - unlimited employees.",
      "sampleEntry": "EMP-00256",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Registering enterprise / company",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Links the employee to the enterprise registered on sheet 01.",
      "sampleEntry": "ENT-000145 - Steelstone IT (Pvt) Ltd",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "Employment category (GATING FIELD)",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Permanent / Probationary / Contract / Daily wage / Apprentice or Trainee / Consultant / Expatriate. Drives which fields below are mandatory.",
      "sampleEntry": "Permanent",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Full name",
      "dataType": "Text (100)",
      "mandatory": "Yes",
