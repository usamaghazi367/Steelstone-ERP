  "fields": [
    {
      "ref": "1.1",
      "field": "Bill booking number",
      "dataType": "Text (15)",
      "mandatory": "System",
      "validation": "Auto-generated, unique and immutable, using the enterprise document prefix (e.g. SSIT-BILL-2026-00145).",
      "sampleEntry": "SSIT-BILL-2026-00145",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Bill type (GATING FIELD)",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Purchase bill (goods) / Freight bill (transport) / Service bill / Utility bill / Expense claim / Debit note. Drives which reference and tax fields are mandatory.",
      "sampleEntry": "Purchase bill (goods)",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "Booking date",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "Date the bill is entered in the ERP; cannot be earlier than the vendor's bill date.",
      "sampleEntry": "46248",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Vendor bill / invoice number",
      "dataType": "Text (30)",
      "mandatory": "Yes",
      "validation": "Number printed on the vendor's own document; must be unique per vendor per financial year.",
      "sampleEntry": "PCI-INV-2026-8891",
      "section": 1
    },
    {
      "ref": "1.5",
      "field": "Vendor bill date",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "Date printed on the vendor's document; must fall inside an open accounting period.",
      "sampleEntry": "46246",
      "section": 1
    },
    {
      "ref": "1.6",
      "field": "Accounting period / posting month",
      "dataType": "Month-Year",
      "mandatory": "System",
      "validation": "Derived from the booking date; the bill is rejected if the period is closed.",
      "sampleEntry": "46235",
      "section": 1
    },
    {
      "ref": "1.7",
      "field": "Currency",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "PKR (default) / USD / EUR - must match the vendor's registered currency.",
      "sampleEntry": "PKR",
      "section": 1
    },
    {
      "ref": "1.8",
      "field": "Exchange rate to base currency",
      "dataType": "Number",
      "mandatory": "Conditional",
      "validation": "Required for foreign currency bills; SBP or contractual rate on the bill date.",
      "sampleEntry": "1",
      "section": 1
    },
    {
      "ref": "1.9",
      "field": "Enterprise entity / company",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Buying entity from sheet 01; determines the tax registration used.",
      "sampleEntry": "ENT-000145 - Steelstone IT (Pvt) Ltd",
      "section": 1
    },
    {
      "ref": "1.10",
      "field": "Business location / plant receiving the supply",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Determines the provincial tax jurisdiction applied.",
      "sampleEntry": "PLANT-01 Nooriabad",
      "section": 1
    },
    {
      "ref": "1.11",
      "field": "Cost centre / department to be charged",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "General ledger cost centre for the expense or inventory posting.",
      "sampleEntry": "CC-2100 Packing Plant",
      "section": 1
    },
    {
      "ref": "1.12",
      "field": "Project / job reference",
      "dataType": "Lookup",
      "mandatory": "Conditional",
      "validation": "Required where the enterprise operates project accounting.",
      "sampleEntry": "PRJ-2026-014",
      "section": 1
    },
    {
      "ref": "1.13",
      "field": "Bill received date & mode",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Physical or electronic receipt date; starts the payment-term clock.",
      "sampleEntry": "13-Aug-2026, email",
      "section": 1
    },
    {
      "ref": "1.14",
      "field": "Bill status",
      "dataType": "Dropdown",
      "mandatory": "System",
      "validation": "Draft / Pending verification / Matched / On hold / Approved / Partially paid / Paid / Rejected / Cancelled.",
      "sampleEntry": "Pending verification",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Vendor type",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Manufacturer (sheet 02) / Distributor (sheet 03) / Transporter (sheet 05) / Service vendor / Utility / Employee (expense claim).",
      "sampleEntry": "Manufacturer",
      "section": 2
    },
    {
      "ref": "2.2",
      "field": "Vendor code & registered name",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Pulled from the vendor register; the legal name must match the bill.",
      "sampleEntry": "MFR-00021 - Pak Cement Industries Limited",
      "section": 2
    },
    {
      "ref": "2.3",
      "field": "Vendor NTN",
      "dataType": "Text (9)",
      "mandatory": "Yes",
      "validation": "Pulled from the vendor master; a mismatch with the bill blocks booking.",
      "sampleEntry": "0098765-4",
      "section": 2
    },
    {
      "ref": "2.4",
      "field": "Vendor STRN",
      "dataType": "Text (13)",
      "mandatory": "Conditional",
      "validation": "Required where input sales tax is claimed.",
      "sampleEntry": "3277800098765",
      "section": 2
    },
    {
      "ref": "2.5",
      "field": "Vendor filer status on the bill date",
      "dataType": "Dropdown",
      "mandatory": "System",
      "validation": "Pulled from the vendor master; if the ATL validity has lapsed the system applies non-filer withholding rates.",
      "sampleEntry": "Filer",
      "section": 2
    },
    {
      "ref": "2.6",
      "field": "Vendor exemption certificate applied",
      "dataType": "Lookup",
      "mandatory": "Conditional",
      "validation": "Certificate from the vendor record; only applied if valid on the bill date.",
      "sampleEntry": "None",
      "section": 2
    },
    {
      "ref": "2.7",
      "field": "Vendor address & city",
      "dataType": "Text (250)",
      "mandatory": "Yes",
      "validation": "Address printed on the bill; used for provincial tax determination.",
      "sampleEntry": "5th Floor, Corporate Tower, I.I. Chundrigar Road, Karachi",
      "section": 2
    },
    {
      "ref": "2.8",
      "field": "Vendor contact person & mobile",
      "dataType": "Text (120)",
      "mandatory": "Yes",
      "validation": "Person to contact for bill queries.",
      "sampleEntry": "Kamran Baig / +92-333-1122334",
      "section": 2
    },
    {
      "ref": "2.9",
      "field": "Vendor bank account for payment",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Primary account from the vendor record; verified before payment release.",
      "sampleEntry": "PK24HABB0007867900123456",
      "section": 2
    },
    {
      "ref": "2.10",
      "field": "Payment terms from vendor contract",
      "dataType": "Dropdown",
      "mandatory": "System",
      "validation": "Pulled from the vendor record (Advance / COD / Net 15 / Net 30 / Net 45 / LC).",
      "sampleEntry": "Net 30",
      "section": 2
    },
    {
      "ref": "2.11",
      "field": "Vendor credit balance / advance held (PKR)",
      "dataType": "Number",
      "mandatory": "System",
      "validation": "Advances or credit notes available for adjustment against this bill.",
      "sampleEntry": "0",
      "section": 2
    },
    {
      "ref": "2.12",
      "field": "Vendor compliance status on the bill date",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Compliant only when the vendor's tax registrations, licences and (for transporters) permits are valid. A non-compliant vendor can be booked but payment release is blocked.",
      "sampleEntry": "Compliant",
      "section": 2
    },
    {
      "ref": "3.1",
      "field": "Purchase order number",
      "dataType": "Lookup",
      "mandatory": "Conditional",
      "validation": "Mandatory for purchase and service bills; the bill cannot exceed the PO value beyond the tolerance.",
      "sampleEntry": "PO-2026-004512",
      "section": 3
    },
    {
      "ref": "3.2",
      "field": "Purchase order date & value",
      "dataType": "Text (60)",
      "mandatory": "System",
      "validation": "Pulled from the purchase order for the three-way match.",
      "sampleEntry": "01-Aug-2026 / PKR 4,260,000",
      "section": 3
    },
    {
      "ref": "3.3",
      "field": "Contract / supply agreement reference",
      "dataType": "Lookup",
      "mandatory": "No",
      "validation": "Master supply or transport agreement governing the rate.",
      "sampleEntry": "MSA-2026-014",
      "section": 3
    },
    {
      "ref": "3.4",
      "field": "Goods receipt note (GRN) number(s)",
      "dataType": "Lookup",
      "mandatory": "Conditional",
      "validation": "One or more GRNs; mandatory for goods bills. Quantity billed must not exceed quantity received.",
      "sampleEntry": "GRN-2026-011245, GRN-2026-011248",
      "section": 3
    },
    {
      "ref": "3.5",
      "field": "GRN date(s) & quantity received",
      "dataType": "Text (80)",
      "mandatory": "System",
      "validation": "Pulled from the GRN for the three-way match.",
      "sampleEntry": "10-Aug-2026 - 300 MT",
      "section": 3
    },
    {
      "ref": "3.6",
      "field": "Dispatch / delivery challan number(s)",
      "dataType": "Text (80)",
      "mandatory": "Conditional",
      "validation": "Vendor's delivery documents supporting the quantity billed.",
      "sampleEntry": "DC-8891, DC-8892",
      "section": 3
    },
    {
      "ref": "3.7",
      "field": "Weighbridge slip number(s) & net weight",
      "dataType": "Text (80)",
      "mandatory": "Conditional",
      "validation": "Required for bulk and bagged cement receipts; net weight governs the payable quantity.",
      "sampleEntry": "WB-44112 - 29.8 MT",
      "section": 3
    },
    {
      "ref": "3.8",
      "field": "Quality / mill test certificate reference",
      "dataType": "Text (60)",
      "mandatory": "Conditional",
      "validation": "Required where incoming quality inspection applies.",
      "sampleEntry": "MTC-2026-3345",
      "section": 3
    },
    {
      "ref": "3.9",
      "field": "Transporter & vehicle reference",
      "dataType": "Lookup",
      "mandatory": "Conditional",
      "validation": "For freight bills: transporter code, vehicle registration and trip reference.",
      "sampleEntry": "TRN-00007 / TLE-1234 / DSP-2026-004512",
      "section": 3
    },
    {
      "ref": "3.10",
      "field": "Inspection / acceptance status",
      "dataType": "Dropdown",
      "mandatory": "Conditional",
      "validation": "Accepted / Accepted with deduction / Rejected - drives any short payment.",
      "sampleEntry": "Accepted with deduction",
      "section": 3
    },
    {
      "ref": "3.11",
      "field": "Shortage, damage or quality claim (PKR)",
      "dataType": "Number",
      "mandatory": "Conditional",
      "validation": "Recovery raised against the vendor; deducted in Section 6.",
      "sampleEntry": "18500",
      "section": 3
    },
    {
      "ref": "3.12",
      "field": "THREE-WAY MATCH RESULT (system-derived)",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Matched only when PO, GRN and bill agree on item, quantity, rate and value within the tolerance set by the enterprise. Unmatched bills cannot be approved for payment.",
      "sampleEntry": "Matched within tolerance",
      "section": 3
    },
    {
      "ref": "4.1",
      "field": "Line number",
      "dataType": "Integer",
      "mandatory": "Yes",
      "validation": "REPEATING BLOCK - unlimited lines per bill.",
      "sampleEntry": "1",
      "section": 4
    },
    {
      "ref": "4.2",
      "field": "Item / material code",
      "dataType": "Lookup",
      "mandatory": "Conditional",
