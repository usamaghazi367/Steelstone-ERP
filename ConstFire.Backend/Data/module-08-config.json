      "section": 4
    },
    {
      "ref": "4.4",
      "field": "HS code / service code",
      "dataType": "Text (12)",
      "mandatory": "Yes",
      "validation": "PCT heading for goods or the service code for services; drives the tax treatment.",
      "sampleEntry": "2523.29",
      "section": 4
    },
    {
      "ref": "4.5",
      "field": "Unit of measure",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "MT / Bag / Litre / Kilometre / Trip / Hour / Lump sum.",
      "sampleEntry": "MT",
      "section": 4
    },
    {
      "ref": "4.6",
      "field": "Quantity billed",
      "dataType": "Number",
      "mandatory": "Yes",
      "validation": "Must not exceed the quantity received on the GRN beyond tolerance.",
