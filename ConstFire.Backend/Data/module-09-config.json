{
  "code": "09",
  "name": "QUOTATION  (SALES QUOTE)",
  "category": "ERP Module",
  "recordCodePrefix": "QOT",
  "listColumns": [
    "_recordCode",
    "1.1",
    "1.2",
    "1.3"
  ],
  "sections": [
    {
      "num": 1,
      "title": "QUOTATION HEADER",
      "repeating": false
    },
    {
      "num": 2,
      "title": "CUSTOMER DETAILS",
      "repeating": false
    },
    {
      "num": 3,
      "title": "QUOTED ITEMS & PRICING  (repeating block - unlimited lines)",
      "repeating": true
    },
    {
      "num": 4,
      "title": "TAXES & QUOTATION SUMMARY",
      "repeating": false
    },
    {
      "num": 5,
      "title": "DELIVERY, FREIGHT & LOGISTICS TERMS",
      "repeating": false
    },
    {
      "num": 6,
      "title": "COMMERCIAL TERMS & VALIDITY",
      "repeating": false
    }
  ],
  "fields": [
    {
      "ref": "1.1",
      "field": "Quotation number",
      "dataType": "Text (15)",
      "mandatory": "System",
      "validation": "Auto-generated using the enterprise prefix; unique and immutable.",
      "sampleEntry": "SSIT-QTN-2026-00312",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Revision number",
      "dataType": "Integer",
      "mandatory": "System",
      "validation": "Increments on every revision; the previous version is retained for audit.",
      "sampleEntry": "0",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "Quotation date",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "Date of issue; must fall in an open period.",
      "sampleEntry": "46248",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Quotation type",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Standard supply / Project-based / Annual rate contract / Spot sale / Tender bid.",
      "sampleEntry": "Project-based",
      "section": 1
    },
    {
      "ref": "1.5",
      "field": "Enterprise entity issuing the quote",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Selling entity from sheet 01.",
      "sampleEntry": "ENT-000145 - Steelstone IT (Pvt) Ltd",
      "section": 1
    },
    {
      "ref": "1.6",
      "field": "Sales person / account manager",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Owner of the quotation and the follow-up.",
      "sampleEntry": "Regional Sales Manager - A. Sheikh",
      "section": 1
    },
    {
      "ref": "1.7",
      "field": "Currency",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "PKR (default) / USD.",
      "sampleEntry": "PKR",
      "section": 1
    },
    {
      "ref": "1.8",
      "field": "Quotation valid from",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "Start of the validity window.",
      "sampleEntry": "46248",
      "section": 1
    },
    {
      "ref": "1.9",
      "field": "Quotation valid until",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "DATE FIELD - amber 7 days before expiry, red once expired. An expired quote cannot be converted into an order.",
      "sampleEntry": "46278",
      "section": 1
    },
    {
      "ref": "1.10",
      "field": "Quotation status (system-derived)",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Draft / Issued / Under negotiation / Accepted / Rejected / EXPIRED (set automatically after the valid-until date) / Converted to order.",
      "sampleEntry": "Issued",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Customer type",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Derived from the customer record selected in field 2.2 (registered customer, distributor or prospect).",
      "sampleEntry": "Registered customer",
      "section": 2
    },
    {
      "ref": "2.2",
      "field": "Customer code & name",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Pulled from the customer register; prospects are quoted against a temporary code.",
      "sampleEntry": "CUST-00512 - Zameen Builders (Pvt) Ltd",
      "section": 2
    },
    {
      "ref": "2.5",
      "field": "Filer status on the quote date",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Filer status pulled from the customer record as at the quote date.",
      "sampleEntry": "Filer",
      "section": 2
    },
    {
      "ref": "2.7",
      "field": "Delivery point(s) quoted for",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Bag or bulker delivery points from the customer record; sets where the material is to be delivered.",
      "sampleEntry": "BULK-01 Batching Plant, Raiwind Road",
      "section": 2
    },
    {
      "ref": "2.8",
      "field": "Contact person & designation",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Contact selected from the points-of-contact block of the customer record.",
      "sampleEntry": "Bilal Nadeem / Procurement Manager",
      "section": 2
    },
    {
      "ref": "2.9",
      "field": "Contact mobile",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Mobile pulled from the selected contact; used to send the quotation and reminders.",
      "sampleEntry": "+92-300-1239876",
      "section": 2
    },
    {
      "ref": "2.10",
      "field": "Outstanding overdue balance (PKR)",
      "dataType": "Number",
      "mandatory": "System",
      "validation": "Overdue receivable; quotes to customers with an overdue balance require approval.",
      "sampleEntry": "0",
      "section": 2
    },
    {
      "ref": "2.11",
      "field": "Customer account status",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Active / Blocked - a blocked customer cannot be quoted without approval.",
      "sampleEntry": "Active",
      "section": 2
    },
    {
      "ref": "3.1",
      "field": "Line number",
      "dataType": "Integer",
      "mandatory": "Yes",
      "validation": "REPEATING BLOCK - one row set per product and packing combination.",
      "sampleEntry": "1",
      "section": 3
    },
    {
      "ref": "3.2",
      "field": "Material code & description",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "From the material definition sheet.",
      "sampleEntry": "MAT-CEM-OPC53-BULK - OPC 53 Grade, bulk",
      "section": 3
    },
    {
      "ref": "3.3",
      "field": "Unit of measure",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "MT / Bag.",
      "sampleEntry": "MT",
      "section": 3
    },
    {
      "ref": "3.4",
      "field": "Quantity quoted",
      "dataType": "Number",
      "mandatory": "Yes",
      "validation": "Quantity offered against this line.",
      "sampleEntry": "10800",
      "section": 3
    },
    {
      "ref": "3.5",
      "field": "Rate per unit (PKR)",
      "dataType": "Number",
      "mandatory": "Yes",
      "validation": "Ex-works rate before freight, discount and tax.",
      "sampleEntry": "13900",
      "section": 3
    },
    {
      "ref": "3.6",
      "field": "Line value before tax (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Quantity quoted multiplied by the rate in field 3.5.",
      "sampleEntry": "154440000",
      "section": 3
    },
    {
      "ref": "3.7",
      "field": "Sales tax rate",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Standard rate applicable to the PCT heading of the material.",
      "sampleEntry": "0.18",
      "section": 3
    },
    {
      "ref": "3.8",
      "field": "Other Taxes",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Applies to cement; calculated per kilogram.",
      "sampleEntry": "PKR 21,600,000",
      "section": 3
    },
    {
      "ref": "4.1",
      "field": "Total quantity quoted (MT)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Sum of all line quantities.",
      "sampleEntry": "18000",
      "section": 4
    },
    {
      "ref": "4.2",
      "field": "Total value before tax (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Sum of all line values before tax.",
      "sampleEntry": "257400000",
      "section": 4
    },
    {
      "ref": "4.3",
      "field": "Total sales tax (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Sum of sales tax across all lines.",
      "sampleEntry": "46332000",
      "section": 4
    },
    {
      "ref": "4.4",
      "field": "Total Other Taxes (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Sum of other taxes across all lines.",
      "sampleEntry": "36000000",
      "section": 4
    },
    {
      "ref": "4.5",
      "field": "Total quotation value including taxes (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Grand total offered to the customer.",
      "sampleEntry": "339732000",
      "section": 4
    },
    {
      "ref": "4.6",
      "field": "Amount in words",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Generated from the grand total.",
      "sampleEntry": "Rupees three hundred thirty nine million ...",
      "section": 4
    },
    {
      "ref": "4.7",
      "field": "Price basis note",
      "dataType": "Text (200)",
      "mandatory": "Yes",
      "validation": "States what the price includes and excludes; printed on the quotation.",
      "sampleEntry": "Rates are FOR site, inclusive of freight, exclusive of unloading",
      "section": 4
    },
    {
      "ref": "5.1",
      "field": "Price basis / Incoterm",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Ex-works collection / FOR destination / Delivered at site.",
      "sampleEntry": "FOR destination",
      "section": 5
    },
    {
      "ref": "5.2",
      "field": "Delivery point(s) & distance (km)",
      "dataType": "Text (150)",
      "mandatory": "Yes",
      "validation": "Each delivery point with the road distance to site.",
      "sampleEntry": "Raiwind Road site - 1,180 km from plant",
      "section": 5
    },
    {
      "ref": "5.3",
      "field": "Delivery mode",
      "dataType": "Text (150)",
      "mandatory": "Yes",
      "validation": "Bag / Bulker / Both - must match the delivery points registered for the customer.",
      "sampleEntry": "Both",
      "section": 5
    },
    {
      "ref": "5.4",
      "field": "Transport arrangement",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Arranged by seller / Arranged by customer / Third-party transporter.",
      "sampleEntry": "Arranged by seller",
      "section": 5
    },
    {
      "ref": "5.5",
      "field": "Force majeure & supply interruption clause",
      "dataType": "Text (200)",
      "mandatory": "Yes",
      "validation": "Covers kiln shutdown, fuel shortage and government restrictions.",
      "sampleEntry": "Standard clause applies",
      "section": 5
    },
    {
      "ref": "6.1",
      "field": "Payment terms offered",
      "dataType": "Lookup - default",
      "mandatory": "Yes",
      "validation": "Defaults from the payment terms on the customer record; an override requires approval and is logged.",
      "sampleEntry": "Net 30",
      "section": 6
    }
  ]
}