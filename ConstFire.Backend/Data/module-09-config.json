      "sampleEntry": "46278",
      "section": 1
    },
    {
      "ref": "1.11",
      "field": "Quotation status (system-derived)",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Draft / Issued / Under negotiation / Accepted / Rejected / EXPIRED (set automatically after the valid-until date) / Converted to order.",
