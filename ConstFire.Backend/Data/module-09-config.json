      "sampleEntry": "PLANT-01 Nooriabad",
      "section": 1
    },
    {
      "ref": "1.7",
      "field": "Sales person / account manager",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Owner of the quotation and the follow-up.",
      "sampleEntry": "Regional Sales Manager - A. Sheikh",
      "section": 1
    },
    {
      "ref": "1.8",
      "field": "Currency",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "PKR (default) / USD.",
      "sampleEntry": "PKR",
      "section": 1
    },
    {
      "ref": "1.9",
      "field": "Quotation valid from",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "Start of the validity window.",
      "sampleEntry": "46248",
      "section": 1
    },
    {
      "ref": "1.10",
      "field": "Quotation valid until",
      "dataType": "Date",
      "mandatory": "Yes",
