  "fields": [
    {
      "ref": "1.1",
      "field": "Quotation number",
      "dataType": "Text (15)",
      "mandatory": "System",
      "validation": "Auto-generated using the enterprise prefix; unique and immutable.",
      "sampleEntry": "SSIT-QTN-2026-00312",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Revision number",
      "dataType": "Integer",
      "mandatory": "System",
      "validation": "Increments on every revision; the previous version is retained for audit.",
      "sampleEntry": "0",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "Quotation date",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "Date of issue; must fall in an open period.",
      "sampleEntry": "46248",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Quotation type",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Standard supply / Project-based / Annual rate contract / Spot sale / Tender bid.",
      "sampleEntry": "Project-based",
      "section": 1
    },
    {
      "ref": "1.5",
      "field": "Enterprise entity issuing the quote",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Selling entity from sheet 01.",
      "sampleEntry": "ENT-000145 - Steelstone IT (Pvt) Ltd",
      "section": 1
    },
    {
      "ref": "1.6",
      "field": "Supplying plant / location",
