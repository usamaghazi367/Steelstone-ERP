    },
    {
      "num": 7,
      "title": "ATTACHMENTS",
      "repeating": false
    }
  ],
  "fields": [
    {
      "ref": "1.1",
      "field": "Invoice number",
      "dataType": "Text (20)",
      "mandatory": "STATUTORY",
      "validation": "Serial number in a continuous, gapless series for the tax period; auto-generated and immutable.",
      "sampleEntry": "SSIT-INV-2026-004512",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Invoice date",
      "dataType": "Date",
      "mandatory": "STATUTORY",
      "validation": "Date of supply or issue; must fall in an open tax period.",
      "sampleEntry": "46315",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "Invoice type",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Tax invoice / Advance receipt invoice / Debit note / Credit note / Export invoice / Exempt supply invoice. An issued invoice is never edited - a correction is made by raising a debit or credit note that references the original invoice number.",
      "sampleEntry": "Tax invoice",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Supplier name, address & NTN",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Registered name, address and NTN of the selling entity pulled from sheet 01.",
      "sampleEntry": "Steelstone IT (Pvt) Ltd, Lahore, NTN 1234567-8",
      "section": 1
    },
    {
      "ref": "1.5",
      "field": "Supplier STRN",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Sales tax registration number of the supplier pulled from sheet 01.",
      "sampleEntry": "3277876543210",
      "section": 1
    },
    {
      "ref": "1.6",
      "field": "Quotation reference",
      "dataType": "Lookup",
      "mandatory": "No",
      "validation": "Quotation from which the order originated.",
      "sampleEntry": "SSIT-QTN-2026-00312",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Customer code & registered name",
      "dataType": "Lookup",
      "mandatory": "STATUTORY",
      "validation": "Name exactly as registered; pulled from sheet 03 or 04.",
      "sampleEntry": "CUST-00512 - Zameen Builders (Pvt) Ltd",
      "section": 2
    },
    {
      "ref": "2.2",
      "field": "Customer address",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Registered address pulled from the customer record selected in field 2.1.",
      "sampleEntry": "78-A, Gulberg II, Lahore, Punjab",
      "section": 2
    },
    {
      "ref": "2.3",
      "field": "Customer NTN",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Buyer's NTN pulled from the customer record.",
      "sampleEntry": "0077331-2",
      "section": 2
    },
    {
      "ref": "2.5",
      "field": "Customer CNIC (unregistered buyers)",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. CNIC pulled from the customer record for unregistered individual buyers.",
      "sampleEntry": "N/A",
      "section": 2
    },
    {
      "ref": "2.6",
      "field": "Exemption certificate applied",
      "dataType": "Lookup",
      "mandatory": "Conditional",
      "validation": "Only applied if valid on the invoice date; otherwise the normal rate is charged.",
      "sampleEntry": "None",
      "section": 2
    },
    {
      "ref": "2.7",
      "field": "Delivery point / ship-to address",
      "dataType": "Lookup",
      "mandatory": "STATUTORY",
      "validation": "Bag or bulker delivery point from the customer record.",
      "sampleEntry": "BULK-01 Batching Plant, Raiwind Road",
      "section": 2
    },
    {
      "ref": "3.1",
      "field": "Dispatch / delivery note number(s)",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Delivery documents being invoiced.",
      "sampleEntry": "DSP-2026-004512",
      "section": 3
    },
    {
      "ref": "3.2",
      "field": "Quantity dispatched",
      "dataType": "Number",
      "mandatory": "System",
      "validation": "Pulled from the dispatch document.",
      "sampleEntry": "30",
      "section": 3
    },
    {
      "ref": "3.3",
      "field": "Delivery basis / Incoterm",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Ex-works / FOR destination / Delivered at site - must match the order.",
      "sampleEntry": "FOR destination",
      "section": 3
    },
    {
      "ref": "4.1",
      "field": "Line number",
      "dataType": "Integer",
      "mandatory": "Yes",
      "validation": "REPEATING BLOCK - one row set per product and packing combination.",
      "sampleEntry": "1",
      "section": 4
    },
    {
      "ref": "4.2",
      "field": "Material code",
      "dataType": "Lookup",
      "mandatory": "STATUTORY",
      "validation": "From the material definition sheet.",
      "sampleEntry": "MAT-CEM-OPC53-BULK",
      "section": 4
    },
    {
      "ref": "4.3",
      "field": "Description of goods or services",
      "dataType": "Text (200)",
      "mandatory": "STATUTORY",
      "validation": "Description as required on a tax invoice.",
      "sampleEntry": "Ordinary Portland Cement, 53 Grade, bulk",
      "section": 4
    },
    {
      "ref": "4.4",
      "field": "Unit of measure",
      "dataType": "Dropdown",
      "mandatory": "STATUTORY",
      "validation": "MT / Bag / Litre.",
      "sampleEntry": "MT",
      "section": 4
    },
    {
      "ref": "4.5",
      "field": "Quantity invoiced",
      "dataType": "Number",
      "mandatory": "STATUTORY",
      "validation": "Must not exceed the dispatched quantity.",
      "sampleEntry": "30",
      "section": 4
    },
    {
      "ref": "4.6",
      "field": "Rate per unit excluding tax (PKR)",
      "dataType": "Number",
      "mandatory": "STATUTORY",
      "validation": "Contract or order rate; deviations are blocked.",
      "sampleEntry": "14300",
      "section": 4
    },
    {
      "ref": "4.7",
      "field": "Gross value (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Quantity multiplied by the rate.",
      "sampleEntry": "429000",
      "section": 4
    },
    {
      "ref": "4.8",
      "field": "Value excluding sales tax (PKR)",
      "dataType": "Formula",
      "mandatory": "STATUTORY",
      "validation": "Gross value of the line; the taxable value.",
      "sampleEntry": "429000",
      "section": 4
    },
    {
      "ref": "4.9",
      "field": "Sales tax rate (%)",
      "dataType": "Formula",
      "mandatory": "STATUTORY",
      "validation": "Standard rate applicable to the PCT heading, or the reduced rate under a valid exemption.",
      "sampleEntry": "0.18",
      "section": 4
    },
    {
      "ref": "4.10",
      "field": "Other tax (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Charged where the buyer has no valid STRN.",
      "sampleEntry": "0",
      "section": 4
    },
    {
      "ref": "4.11",
      "field": "Revenue GL account & cost centre",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Sales account credited and the cost centre for reporting.",
      "sampleEntry": "4100-Sales Revenue / CC-3100",
      "section": 4
    },
    {
      "ref": "5.1",
      "field": "Total quantity invoiced",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Sum of all line quantities.",
      "sampleEntry": "30 MT",
      "section": 5
    },
    {
      "ref": "5.2",
      "field": "Total sales tax (PKR)",
      "dataType": "Formula",
      "mandatory": "STATUTORY",
      "validation": "Sales tax charged on the invoice.",
      "sampleEntry": "77220",
      "section": 5
    },
    {
      "ref": "5.3",
      "field": "Other tax (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Total further tax on supplies to unregistered buyers.",
      "sampleEntry": "0",
      "section": 5
    },
    {
      "ref": "5.4",
      "field": "Total invoice value (PKR)",
      "dataType": "Formula",
      "mandatory": "STATUTORY",
      "validation": "Grand total payable by the customer.",
      "sampleEntry": "566220",
      "section": 5
    },
    {
      "ref": "5.5",
      "field": "Amount in words",
      "dataType": "Formula",
      "mandatory": "STATUTORY",
      "validation": "Generated from the invoice total.",
      "sampleEntry": "Rupees five hundred sixty six thousand two hundred twenty only",
      "section": 5
    },
    {
      "ref": "6.1",
      "field": "Payment terms",
      "dataType": "Lookup - default",
      "mandatory": "Yes",
      "validation": "Defaults from the payment terms on the customer record; an override requires approval and is logged.",
      "sampleEntry": "Net 30",
      "section": 6
    },
    {
      "ref": "6.2",
      "field": "Payment due date",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Invoice date plus the payment terms period; drives the receivable ageing bucket.",
      "sampleEntry": "46345",
      "section": 6
    },
    {
      "ref": "6.3",
      "field": "Advance received against this invoice (PKR)",
      "dataType": "Number",
      "mandatory": "No",
      "validation": "Advance adjusted, with the receipt reference.",
      "sampleEntry": "0",
      "section": 6
    },
    {
      "ref": "6.4",
      "field": "Amount received to date (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Sum of receipts posted against this invoice.",
      "sampleEntry": "0",
      "section": 6
    },
    {
      "ref": "6.5",
      "field": "Balance outstanding & invoice status",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Invoice total less receipts applied. Sets the invoice status - Issued / Partially paid / Paid / Overdue / Cancelled - and feeds the receivable ageing and the statement of account.",
      "sampleEntry": "566220",
      "section": 6
    },
    {
      "ref": "6.6",
      "field": "Receipt reference(s)",
      "dataType": "Lookup",
      "mandatory": "System",
      "validation": "Receipts or bank credits applied against this invoice.",
      "sampleEntry": "Pending",
      "section": 6
    },
    {
      "ref": "7.1",
      "field": "Signed delivery challan",
      "dataType": "File upload",
      "mandatory": "Yes",
      "validation": "Acknowledged by the customer at the delivery point.",
      "sampleEntry": "Attached",
      "section": 7
    },
    {
      "ref": "7.2",
      "field": "Weighbridge slip",
      "dataType": "File upload",
      "mandatory": "Yes",
      "validation": "Supports the invoiced quantity for bulk supplies.",
      "sampleEntry": "Attached",
      "section": 7
    },
    {
      "ref": "7.3",
      "field": "Mill test / quality certificate",
      "dataType": "File upload",
      "mandatory": "Conditional",
      "validation": "Issued with the dispatch where required.",
      "sampleEntry": "Attached",
      "section": 7
    },
    {
      "ref": "7.4",
      "field": "Customer purchase order / work order",
      "dataType": "File upload",
      "mandatory": "Yes",
      "validation": "Supports the sales order and the rate charged.",
      "sampleEntry": "Attached",
      "section": 7
    },
    {
      "ref": "7.5",
      "field": "Exemption certificate applied",
      "dataType": "File upload",
      "mandatory": "Conditional",
      "validation": "Must be valid on the invoice date.",
      "sampleEntry": "N/A",
      "section": 7
    }
  ]
}