      "mandatory": "System",
      "validation": "Movement versus the prior month; a variance beyond tolerance requires explanation.",
      "sampleEntry": "0.021",
      "section": 5
    },
    {
      "ref": "5.9",
      "field": "Variance explanation",
      "dataType": "Text (250)",
