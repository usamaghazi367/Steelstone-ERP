      "sampleEntry": "0",
      "section": 3
    },
    {
      "ref": "3.8",
      "field": "Bonus / ex-gratia (PKR)",
      "dataType": "Number",
      "mandatory": "No",
      "validation": "Statutory or discretionary bonus paid in this run.",
      "sampleEntry": "0",
      "section": 3
    },
    {
      "ref": "3.9",
      "field": "Reimbursements (fuel, mobile, medical)",
      "dataType": "Number",
      "mandatory": "No",
      "validation": "Non-taxable reimbursements against claims.",
      "sampleEntry": "4500",
      "section": 3
    },
    {
      "ref": "3.10",
      "field": "GROSS EARNINGS (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Sum of all earnings for the employee for the period.",
      "sampleEntry": "165365",
      "section": 3
    },
    {
      "ref": "4.1",
      "field": "Income tax withheld (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Monthly withholding on salary as per the applicable slab for the tax year.",
      "sampleEntry": "12450",
      "section": 4
    },
    {
      "ref": "4.2",
      "field": "Taxable salary year to date (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Cumulative taxable income used to project the annual tax liability.",
      "sampleEntry": "496095",
      "section": 4
    },
    {
      "ref": "4.3",
      "field": "Loan / advance instalment recovery (PKR)",
