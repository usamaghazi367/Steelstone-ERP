      "validation": "Credited against the employee loan ledger.",
      "sampleEntry": "620000",
      "section": 5
    },
    {
      "ref": "5.5",
      "field": "Total other deductions (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Union dues, canteen and authorised recoveries.",
      "sampleEntry": "148000",
      "section": 5
    },
    {
      "ref": "5.6",
      "field": "TOTAL NET DISBURSEMENT (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Amount to be transferred to employee accounts.",
      "sampleEntry": "27110240",
      "section": 5
    },
    {
      "ref": "5.7",
      "field": "Total employer cost for the period (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Gross plus all employer contributions; posted to the cost centres.",
      "sampleEntry": "35076800",
      "section": 5
    },
    {
      "ref": "5.8",
      "field": "Variance against previous period (%)",
