{
  "code": "12",
  "name": "PAYROLL",
  "category": "ERP Module",
  "recordCodePrefix": "PRL",
  "listColumns": [
    "_recordCode",
    "1.1",
    "1.2",
    "1.3"
  ],
  "sections": [
    {
      "num": 1,
      "title": "PAYROLL RUN HEADER",
      "repeating": false
    },
    {
      "num": 2,
      "title": "EMPLOYEE PAYROLL LINE  (repeating block - one row set per employee)",
      "repeating": true
    },
    {
      "num": 3,
      "title": "EARNINGS",
      "repeating": false
    },
    {
      "num": 4,
      "title": "DEDUCTIONS & NET PAY",
      "repeating": false
    },
    {
      "num": 5,
      "title": "PAYROLL REGISTER SUMMARY  (whole batch)",
      "repeating": false
    },
    {
      "num": 6,
      "title": "STATUTORY FILING & DEPOSITS",
      "repeating": false
    }
  ],
  "fields": [
    {
      "ref": "1.1",
      "field": "Payroll batch number",
      "dataType": "Text (15)",
      "mandatory": "System",
      "validation": "Auto-generated, unique and immutable (e.g. SSIT-PAY-2026-09).",
      "sampleEntry": "SSIT-PAY-2026-09",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Payroll period (month & year)",
      "dataType": "Month-Year",
      "mandatory": "Yes",
      "validation": "One regular run per period per entity; duplicates are blocked.",
      "sampleEntry": "46266",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "Period start & end date",
      "dataType": "Date range",
      "mandatory": "Yes",
      "validation": "Wage period as defined by the enterprise.",
      "sampleEntry": "01-Sep-2026 to 30-Sep-2026",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Payroll type",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Regular monthly / Daily wage / Contract staff / Off-cycle or supplementary / Final settlement / Bonus run.",
      "sampleEntry": "Regular monthly",
      "section": 1
    },
    {
      "ref": "1.5",
      "field": "Enterprise entity",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Paying entity from sheet 01; determines the tax and statutory registrations used.",
      "sampleEntry": "ENT-000145 - Steelstone IT (Pvt) Ltd",
      "section": 1
    },
    {
      "ref": "1.6",
      "field": "Attendance cut-off date",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "Date to which attendance and overtime are considered.",
      "sampleEntry": "46290",
      "section": 1
    },
    {
      "ref": "1.7",
      "field": "Number of employees in the run",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Count of active employees pulled from sheet 07 for the selected criteria.",
      "sampleEntry": "248",
      "section": 1
    },
    {
      "ref": "1.8",
      "field": "Payment date",
      "dataType": "Date",
      "mandatory": "Yes",
      "validation": "Salary must be paid within 7 days of the end of the wage period.",
      "sampleEntry": "46298",
      "section": 1
    },
    {
      "ref": "1.9",
      "field": "Currency",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "PKR.",
      "sampleEntry": "PKR",
      "section": 1
    },
    {
      "ref": "1.10",
      "field": "Payroll status",
      "dataType": "Dropdown",
      "mandatory": "System",
      "validation": "Draft / Calculated / Under review / Approved / Disbursed / Reversed.",
      "sampleEntry": "Calculated",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Employee code & name",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Pulled from the employee register on sheet 07.",
      "sampleEntry": "EMP-00256 - Usman Ghani",
      "section": 2
    },
    {
      "ref": "2.3",
      "field": "Employment category & status",
      "dataType": "Text (80)",
      "mandatory": "System",
      "validation": "Only Active, On leave and Notice-period employees are included.",
      "sampleEntry": "Permanent - Active",
      "section": 2
    },
    {
      "ref": "2.4",
      "field": "Payable days in the period",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Calendar or working days less unpaid absence.",
      "sampleEntry": "30",
      "section": 2
    },
    {
      "ref": "2.5",
      "field": "Days present",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "From the attendance system for the period.",
      "sampleEntry": "26",
      "section": 2
    },
    {
      "ref": "2.6",
      "field": "Paid leave days availed",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Annual, casual and sick leave approved within entitlement.",
      "sampleEntry": "2",
      "section": 2
    },
    {
      "ref": "2.7",
      "field": "Unpaid leave / absent days",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Deducted from the gross salary on a pro-rata basis.",
      "sampleEntry": "0",
      "section": 2
    },
    {
      "ref": "2.8",
      "field": "Late arrivals / short hours deduction",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Applied under the attendance policy.",
      "sampleEntry": "0",
      "section": 2
    },
    {
      "ref": "2.9",
      "field": "Overtime hours approved",
      "dataType": "Number",
      "mandatory": "Conditional",
      "validation": "Approved by the overtime authority recorded in the employee master.",
      "sampleEntry": "12",
      "section": 2
    },
    {
      "ref": "2.10",
      "field": "Weekly holiday / gazetted holiday worked",
      "dataType": "Number",
      "mandatory": "No",
      "validation": "Paid at the enhanced rate under the Factories Act.",
      "sampleEntry": "1 day",
      "section": 2
    },
    {
      "ref": "2.11",
      "field": "Employee bank account number",
      "dataType": "Lookup",
      "mandatory": "System",
      "validation": "Verified salary account from the employee master.",
      "sampleEntry": "5120010044556",
      "section": 2
    },
    {
      "ref": "3.1",
      "field": "Basic salary (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Pro-rated for payable days.",
      "sampleEntry": "81000",
      "section": 3
    },
    {
      "ref": "3.2",
      "field": "House rent allowance (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Normally 45% of basic salary.",
      "sampleEntry": "36450",
      "section": 3
    },
    {
      "ref": "3.4",
      "field": "Shift / site / hardship allowance (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Paid according to the shift roster worked.",
      "sampleEntry": "8000",
      "section": 3
    },
    {
      "ref": "3.5",
      "field": "Overtime amount (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Overtime hours at twice the ordinary rate (Factories Act 1934).",
      "sampleEntry": "9750",
      "section": 3
    },
    {
      "ref": "3.6",
      "field": "Holiday / rest-day working payment (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Enhanced rate for work on a weekly or gazetted holiday.",
      "sampleEntry": "3115",
      "section": 3
    },
    {
      "ref": "3.7",
      "field": "Arrears of previous period (PKR)",
      "dataType": "Number",
      "mandatory": "No",
