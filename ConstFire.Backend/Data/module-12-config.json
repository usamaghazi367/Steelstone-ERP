      "sampleEntry": "5000",
      "section": 4
    },
    {
      "ref": "4.4",
      "field": "Unpaid leave / absence deduction (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Pro-rata deduction for unpaid days.",
      "sampleEntry": "0",
      "section": 4
    },
    {
      "ref": "4.5",
      "field": "Penalty / disciplinary deduction (PKR)",
      "dataType": "Number",
      "mandatory": "No",
      "validation": "Only with documented approval as permitted by law.",
      "sampleEntry": "0",
      "section": 4
    },
    {
      "ref": "4.6",
      "field": "TOTAL DEDUCTIONS (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Sum of all employee-side deductions.",
      "sampleEntry": "25367",
      "section": 4
    },
    {
      "ref": "4.7",
      "field": "NET PAYABLE TO EMPLOYEE (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Gross earnings less total deductions; must never be negative.",
      "sampleEntry": "139998",
      "section": 4
    },
    {
      "ref": "4.8",
      "field": "Employer cost for the period (PKR)",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Gross earnings plus any employer-side contributions payable for the employee.",
      "sampleEntry": "176962",
      "section": 4
    },
    {
      "ref": "5.1",
      "field": "Total employees paid",
