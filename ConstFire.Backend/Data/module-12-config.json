      "sampleEntry": "6 new joiners in Production",
      "section": 5
    },
    {
      "ref": "5.11",
      "field": "Exception report",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Lists negative net pay, zero attendance, missing bank details and duplicate employee records. Must be cleared before the run is approved.",
      "sampleEntry": "0 exceptions",
      "section": 5
    },
    {
      "ref": "6.1",
      "field": "Income tax deposit due date",
      "dataType": "Formula",
