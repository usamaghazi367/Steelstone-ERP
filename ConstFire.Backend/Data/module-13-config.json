  "fields": [
    {
      "ref": "1.1",
      "field": "Material code",
      "dataType": "Text (20)",
      "mandatory": "System",
      "validation": "Auto-generated from the category and type; unique and immutable once approved.",
      "sampleEntry": "MAT-CEM-OPC53-BULK",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Material type (GATING FIELD)",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Finished goods / Raw material / Packing material / Spare part / Consumable / Fuel / Service. Drives which sections below are mandatory.",
      "sampleEntry": "Finished goods",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "Material category & sub-category",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Cement / Clinker / Limestone / Gypsum / Coal / Bags / Lubricants / Electrical / Mechanical spares.",
      "sampleEntry": "Cement / Grey Portland",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Material description (short)",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Appears on orders, challans and invoices.",
      "sampleEntry": "OPC 53 Grade - Bulk",
      "section": 1
    },
    {
      "ref": "1.5",
      "field": "HS code / PCT heading",
      "dataType": "Text (12)",
      "mandatory": "Yes",
      "validation": "Determines the sales tax, other tax and customs treatment on every transaction.",
      "sampleEntry": "2523.29",
      "section": 1
    },
    {
      "ref": "1.6",
      "field": "Material status",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Active / Blocked for purchase / Blocked for sale / Under approval / Discontinued - with effective date. Codes are never deleted.",
      "sampleEntry": "Active",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Base unit of measure",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "MT / Kg / Bag / Litre / Piece / Metre / Hour. All stock is held in this unit.",
      "sampleEntry": "MT",
      "section": 2
    },
    {
      "ref": "2.2",
      "field": "Packing type & conversion to base unit",
      "dataType": "Text (60)",
      "mandatory": "Conditional",
      "validation": "Bulk / 50 kg PP bag / 50 kg paper bag / Jumbo bag 1.5 MT / Drum / Carton, together with the quantity of the base unit in each pack (e.g. 20 bags per MT). This conversion drives bag-to-MT quantities on quotations, invoices and delivery challans.",
      "sampleEntry": "50 kg PP bag - 20 bags per MT",
      "section": 2
    },
    {
      "ref": "3.1",
      "field": "Applicable standard",
      "dataType": "Text (60)",
      "mandatory": "Conditional",
      "validation": "PS, ASTM, EN or BS standard the material conforms to.",
      "sampleEntry": "PS 232-2015 / ASTM C150 Type I",
      "section": 3
    },
    {
      "ref": "3.2",
      "field": "Key specification parameters",
      "dataType": "Text (250)",
      "mandatory": "Conditional",
      "validation": "Strength, setting time, fineness, chemical composition or equivalent.",
      "sampleEntry": "28-day strength min 53 MPa, Blaine 3200 cm2/g",
      "section": 3
    },
    {
      "ref": "3.3",
      "field": "Mill test certificate required",
      "dataType": "Yes / No",
      "mandatory": "Conditional",
      "validation": "Required with every dispatch or receipt of the material.",
      "sampleEntry": "Yes",
      "section": 3
    },
    {
      "ref": "3.4",
      "field": "Shelf life / expiry applicable",
      "dataType": "Yes / No",
      "mandatory": "Yes",
      "validation": "If Yes, batch and expiry tracking are enforced.",
      "sampleEntry": "Yes",
      "section": 3
    },
    {
      "ref": "3.5",
      "field": "Batch / lot tracking required",
      "dataType": "Yes / No",
      "mandatory": "Yes",
      "validation": "Enables batch-wise traceability from production to delivery.",
      "sampleEntry": "Yes",
      "section": 3
    },
    {
      "ref": "4.1",
      "field": "Sales tax applicability",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Taxable at standard rate / Reduced rate / Zero-rated / Exempt.",
      "sampleEntry": "Taxable at standard rate",
      "section": 4
    },
    {
      "ref": "4.2",
      "field": "Standard sales tax rate (%)",
      "dataType": "Number",
      "mandatory": "Yes",
      "validation": "Rate applied on sales and purchases of this material.",
      "sampleEntry": "0.18",
      "section": 4
    },
    {
      "ref": "4.3",
      "field": "Other Tax",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Applies to cement and other excisable goods. State whether the tax applies and the rate and basis used - amount per kilogram or percentage of value - which the ERP applies on every purchase and sale of this material.",
      "sampleEntry": "Yes",
      "section": 4
    },
    {
      "ref": "4.4",
      "field": "Withholding tax section on purchase",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Section 153 goods or services rate applied when buying this material.",
      "sampleEntry": "Sec. 153(1)(a) - goods",
      "section": 4
    },
    {
      "ref": "5.1",
      "field": "Inventory managed",
      "dataType": "Yes / No",
      "mandatory": "Yes",
      "validation": "Services and expense items are not stock-managed.",
      "sampleEntry": "Yes",
      "section": 5
    },
    {
      "ref": "5.2",
      "field": "Valuation method",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "FIFO / Weighted average - must match the enterprise configuration.",
      "sampleEntry": "Weighted average",
      "section": 5
    },
    {
      "ref": "5.3",
      "field": "Cost basis - last purchase price & date",
      "dataType": "Formula",
      "mandatory": "System",
      "validation": "Maintained automatically from the most recent booked bill. This is the cost basis used for inventory valuation and for the quotation margin check on sheet 09.",
      "sampleEntry": "PKR 11,400 on 12-Aug-2026",
      "section": 5
    },
    {
      "ref": "5.4",
      "field": "Minimum stock level (reorder point)",
      "dataType": "Number",
      "mandatory": "Conditional",
      "validation": "Triggers a purchase requisition when stock falls below this level.",
      "sampleEntry": "500 MT",
      "section": 5
    },
    {
      "ref": "5.5",
      "field": "Maximum stock level",
      "dataType": "Number",
      "mandatory": "Conditional",
      "validation": "Storage capacity constraint; over-receipt is warned.",
      "sampleEntry": "2000 MT",
      "section": 5
    },
    {
      "ref": "5.6",
      "field": "Procurement lead time (days)",
      "dataType": "Integer",
      "mandatory": "Conditional",
      "validation": "Used by planning to time the reorder.",
      "sampleEntry": "3",
      "section": 5
    },
    {
      "ref": "6.1",
      "field": "Purchasable",
      "dataType": "Yes / No",
      "mandatory": "Yes",
      "validation": "Whether the material can be placed on a purchase order.",
      "sampleEntry": "No - produced in-house",
      "section": 6
    },
    {
      "ref": "6.2",
      "field": "Saleable",
      "dataType": "Yes / No",
      "mandatory": "Yes",
      "validation": "Whether the material can be placed on a sales order or invoice.",
      "sampleEntry": "Yes",
      "section": 6
    },
    {
      "ref": "6.3",
      "field": "Minimum selling price (floor price)",
      "dataType": "Number",
      "mandatory": "Conditional",
      "validation": "Quotations and orders below this rate are blocked pending approval.",
      "sampleEntry": "13500 per MT",
      "section": 6
    },
    {
      "ref": "6.4",
      "field": "Revenue GL account",
      "dataType": "Lookup",
      "mandatory": "Conditional",
      "validation": "Account credited when the material is sold.",
      "sampleEntry": "4100-Sales Revenue",
      "section": 6
    },
    {
      "ref": "6.5",
      "field": "Inventory GL account",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Account debited when the material is received into stock.",
      "sampleEntry": "1310-Finished Goods Inventory",
      "section": 6
    },
    {
      "ref": "6.6",
      "field": "Cost of sales GL account",
      "dataType": "Lookup",
      "mandatory": "Conditional",
      "validation": "Account debited when the material is dispatched.",
      "sampleEntry": "5100-Cost of Sales",
      "section": 6
    }
  ]
}