      "repeating": false
    }
  ],
  "fields": [
    {
      "ref": "1.1",
      "field": "Delivery challan number",
      "dataType": "Text (20)",
      "mandatory": "System",
      "validation": "Auto-generated, unique, gapless and immutable.",
      "sampleEntry": "SSIT-DC-2026-008891",
      "section": 1
    },
    {
      "ref": "1.2",
      "field": "Challan date & time of issue",
      "dataType": "Date-time",
      "mandatory": "Yes",
      "validation": "Time stamped at issue; governs the gate-out window.",
      "sampleEntry": "46314.5277777778",
      "section": 1
    },
    {
      "ref": "1.3",
      "field": "Challan type",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Sale delivery / Stock transfer between locations / Sample or free issue / Return to supplier / Job work.",
      "sampleEntry": "Sale delivery",
      "section": 1
    },
    {
      "ref": "1.4",
      "field": "Sales order reference",
      "dataType": "Lookup",
      "mandatory": "Conditional",
      "validation": "Mandatory for sale deliveries; the challan cannot exceed the open order quantity.",
      "sampleEntry": "SO-2026-002211",
      "section": 1
    },
    {
      "ref": "1.5",
      "field": "Enterprise entity & supplying plant",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Dispatching entity and location; determines the province of supply.",
      "sampleEntry": "ENT-000145 / PLANT-01 Nooriabad",
      "section": 1
    },
    {
      "ref": "1.6",
      "field": "Delivery mode",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Bag / Bulker - must match the delivery point registered for the customer.",
      "sampleEntry": "Bulker",
      "section": 1
    },
    {
      "ref": "1.7",
      "field": "Expected delivery date & time",
      "dataType": "Date-time",
      "mandatory": "Yes",
      "validation": "Committed arrival at the delivery point; printed on the challan for the driver and the consignee.",
      "sampleEntry": "46316.5833333333",
      "section": 1
    },
    {
      "ref": "1.8",
      "field": "Freight payable by",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "Seller / Customer / To-pay by consignee.",
      "sampleEntry": "Seller",
      "section": 1
    },
    {
      "ref": "1.9",
      "field": "Printed copies issued",
      "dataType": "Text (60)",
      "mandatory": "System",
      "validation": "Original for consignee, duplicate for transporter, triplicate for the plant record.",
      "sampleEntry": "3 copies",
      "section": 1
    },
    {
      "ref": "1.10",
      "field": "Challan status",
      "dataType": "Dropdown",
      "mandatory": "System",
      "validation": "Issued / In transit / Delivered / Partially delivered / Returned / Cancelled.",
      "sampleEntry": "Issued",
      "section": 1
    },
    {
      "ref": "2.1",
      "field": "Customer code & name",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Pulled from the customer or distributor register.",
      "sampleEntry": "CUST-00512 - Zameen Builders (Pvt) Ltd",
      "section": 2
    },
    {
      "ref": "2.2",
      "field": "Customer NTN / STRN",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. NTN and STRN pulled from the customer record selected in field 2.1.",
      "sampleEntry": "0077331-2 / 3277800773312",
      "section": 2
    },
    {
      "ref": "2.4",
      "field": "Ship-to delivery point",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Bag or bulker delivery point registered for this customer.",
      "sampleEntry": "BULK-01 Batching Plant, Raiwind Road",
      "section": 2
    },
    {
      "ref": "2.5",
      "field": "Ship-to full address",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Full address pulled from the delivery point selected in field 2.4; printed on the challan for the driver.",
      "sampleEntry": "Plot 22, Sundar Industrial Estate, Raiwind Road, Lahore",
      "section": 2
    },
    {
      "ref": "2.7",
      "field": "Site contact name & mobile",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Site contact pulled from the delivery point record on the customer master.",
      "sampleEntry": "Engr. Umar Farooq / +92-321-7788990",
      "section": 2
    },
    {
      "ref": "2.8",
      "field": "Site receiving hours & access constraints",
      "dataType": "Text (150)",
      "mandatory": "System",
      "validation": "Pulled from the customer delivery point record.",
      "sampleEntry": "24 hours; max 50 MT tanker",
      "section": 2
    },
    {
      "ref": "3.1",
      "field": "Transporter code & name",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "From the transporter register on sheet 05.",
      "sampleEntry": "TRN-00007 - Shaheen Goods Transport Company",
      "section": 3
    },
    {
      "ref": "3.2",
      "field": "Vehicle registration number",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "From the vehicle register on sheet 06; only Available vehicles can be selected.",
      "sampleEntry": "TLE-1234",
      "section": 3
    },
    {
      "ref": "3.3",
      "field": "Vehicle type",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Vehicle type pulled from the vehicle master on sheet 06.",
      "sampleEntry": "Bulk tanker / 30 MT",
      "section": 3
    },
    {
      "ref": "3.4",
      "field": "Vehicle compliance status at dispatch",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Derived from the vehicle register: a vehicle with an expired route permit, fitness certificate or token tax CANNOT be allocated.",
      "sampleEntry": "Compliant",
      "section": 3
    },
    {
      "ref": "3.5",
      "field": "Driver name",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "ANY active, compliant driver from the driver register may be assigned; the driver-vehicle link is created here at dispatch.",
      "sampleEntry": "Muhammad Ilyas",
      "section": 3
    },
    {
      "ref": "3.6",
      "field": "Driver licence number & class",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Licence number and class pulled from the driver's employee record on sheet 07.",
      "sampleEntry": "SIN-HTV-2016-44821 / HTV",
      "section": 3
    },
    {
      "ref": "3.7",
      "field": "Driver compliance status at dispatch",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "A driver with an expired licence, medical or police verification CANNOT be assigned.",
      "sampleEntry": "Compliant",
      "section": 3
    },
    {
      "ref": "3.8",
      "field": "Driver mobile number",
      "dataType": "Lookup - read only",
      "mandatory": "System",
      "validation": "NO MANUAL ENTRY. Mobile pulled from the driver's employee record; used for trip tracking and site coordination.",
      "sampleEntry": "+92-345-6677889",
      "section": 3
    },
    {
      "ref": "3.9",
      "field": "GPS tracking device & live link",
      "dataType": "Text (80)",
      "mandatory": "No",
      "validation": "Tracking device ID or live link, entered at dispatch where the vehicle has one; the customer may be sent the tracking link.",
      "sampleEntry": "TPL Trakker 860123045678901",
      "section": 3
    },
    {
      "ref": "4.1",
      "field": "Line number",
      "dataType": "Integer",
      "mandatory": "Yes",
      "validation": "REPEATING BLOCK - one row set per material and packing type on the vehicle.",
      "sampleEntry": "1",
      "section": 4
    },
    {
      "ref": "4.2",
      "field": "Material code & description",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "From the material definition sheet.",
      "sampleEntry": "MAT-CEM-OPC53-BULK - OPC 53 Grade, bulk",
      "section": 4
    },
    {
      "ref": "4.3",
      "field": "Unit of measure",
      "dataType": "Dropdown",
      "mandatory": "Yes",
      "validation": "MT / Bag.",
      "sampleEntry": "MT",
      "section": 4
    },
    {
      "ref": "4.4",
      "field": "Quantity ordered (open balance)",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Remaining quantity on the sales order before this dispatch.",
      "sampleEntry": "18000",
      "section": 4
    },
    {
      "ref": "4.5",
      "field": "Quantity dispatched",
      "dataType": "Number",
      "mandatory": "Yes",
      "validation": "Cannot exceed the open order balance.",
      "sampleEntry": "30",
      "section": 4
    },
    {
      "ref": "4.6",
      "field": "Batch / lot number & mill test certificate number",
      "dataType": "Text (40)",
      "mandatory": "Conditional",
      "validation": "Batch or lot number is mandatory for materials flagged 'Batch / lot tracking required' on sheet 13; the mill test certificate number is recorded alongside it where the customer requires one.",
      "sampleEntry": "MTC-2026-3345",
      "section": 4
    },
    {
      "ref": "4.7",
      "field": "Stock movement posted at plant",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Inventory is reduced at the supplying location on gate-out.",
      "sampleEntry": "Posted",
      "section": 4
    },
    {
      "ref": "6.1",
      "field": "Arrival date & time at delivery point",
      "dataType": "Date-time",
      "mandatory": "Yes",
      "validation": "Recorded by the driver or the site contact on arrival; measures delivery performance against field 1.7.",
      "sampleEntry": "46316.5555555556",
      "section": 6
    },
    {
      "ref": "6.2",
      "field": "Unloading start & completion time",
      "dataType": "Text (60)",
      "mandatory": "Yes",
      "validation": "Free unloading time is measured from arrival.",
      "sampleEntry": "13:40 to 16:10",
      "section": 6
    },
    {
      "ref": "6.3",
      "field": "Quantity received at site",
      "dataType": "Number",
      "mandatory": "Yes",
      "validation": "Quantity acknowledged by the consignee.",
      "sampleEntry": "30",
      "section": 6
    },
    {
      "ref": "6.4",
      "field": "Received by - name & designation",
      "dataType": "Lookup - read only",
      "mandatory": "Yes",
      "validation": "NO MANUAL ENTRY. Selected from the customer's points of contact; free-text names are not accepted.",
      "sampleEntry": "Engr. Umar Farooq / Plant Manager",
      "section": 6
    },
    {
      "ref": "6.5",
      "field": "Consignee signature & stamp",
      "dataType": "File upload / e-sign",
      "mandatory": "Yes",
      "validation": "Signed challan copy or a digital proof of delivery with geo-tag.",
      "sampleEntry": "Attached",
      "section": 6
    },
    {
      "ref": "7.1",
      "field": "Goods returned (quantity & reason)",
      "dataType": "Text (150)",
      "mandatory": "Conditional",
      "validation": "Rejected or undelivered quantity returned to the plant.",
      "sampleEntry": "Nil",
      "section": 7
    },
    {
      "ref": "7.2",
      "field": "Return challan reference",
      "dataType": "Text (30)",
      "mandatory": "Conditional",
      "validation": "Raised where material comes back; stock is reinstated on receipt.",
      "sampleEntry": "N/A",
      "section": 7
    },
    {
      "ref": "7.3",
      "field": "Claim raised - type, amount & status",
      "dataType": "Text (200)",
      "mandatory": "Conditional",
      "validation": "Shortage, damage or quality claim arising on this delivery: type, amount and status (Not applicable / Under review / Accepted / Rejected / Settled). Recovered from the transporter or credited to the customer.",
      "sampleEntry": "Not applicable",
      "section": 7
    },
    {
      "ref": "7.4",
      "field": "Tax invoice raised against this challan",
      "dataType": "Lookup",
      "mandatory": "Yes",
      "validation": "Invoice number and date; a challan cannot remain uninvoiced beyond the tax period.",
      "sampleEntry": "SSIT-INV-2026-004512, 20-Oct-2026",
      "section": 7
    },
    {
      "ref": "7.5",
      "field": "Invoiced quantity versus delivered quantity",
      "dataType": "Formula - read only",
      "mandatory": "System",
      "validation": "Must reconcile; any difference requires a credit note.",
      "sampleEntry": "Matched",
      "section": 7
    },
    {
      "ref": "7.6",
      "field": "Freight bill raised by transporter",
      "dataType": "Lookup",
      "mandatory": "Conditional",
      "validation": "Freight bill covering this trip; links to sheet 08.",
      "sampleEntry": "Pending",
      "section": 7
    }
  ]
}